# Document Grist ciblé (DEV par défaut, ne jamais pointer un prototype sur PROD sans validation)
GRIST_BASE_URL=https://grist.numerique.gouv.fr
GRIST_DOC_ID=
# Clé API propriétaire du document : uniquement côté serveur, jamais exposée au navigateur
GRIST_API_KEY=
# Taille maximale d'un CV, en octets
CV_MAX_BYTES=5242880

# URL publique de l'application (liens des courriers)
PUBLIC_URL=http://localhost:3000
# Envoi des courriers : `log` (journal seulement) ou `smtp`
MAIL_TRANSPORT=log
MAIL_FROM=Eclauses - Ministère de la Culture <contact@eclauses.beta.gouv.fr>
SUPPORT_TO=contact@eclauses.beta.gouv.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Secrets d'appel : webhooks Grist (en-tête Authorization: Bearer ...) et tâches planifiées
WEBHOOK_SECRET=
CRON_SECRET=
# Nombre de proxys (répartiteur de charge) devant l'application : détermine l'adresse IP retenue dans X-Forwarded-For
TRUSTED_PROXIES=1
# Délai minimal entre deux relances d'un titulaire, en jours
RELANCE_TITULAIRE_DELAY_DAYS=7

# Base PostgreSQL (développement : service `db` de docker-compose, port 5434)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://eclauses:<mot de passe>@127.0.0.1:5434/eclauses
# Stockage des fichiers : `local` (dossier) ou, plus tard, `s3`
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/fichiers
# Stockage S3 (STORAGE_DRIVER=s3) : Scaleway Object Storage, par exemple https://s3.fr-par.scw.cloud
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Clé de chiffrement (64 caractères hexadécimaux) des secrets de double authentification des administrateurs
MFA_ENCRYPTION_KEY=
