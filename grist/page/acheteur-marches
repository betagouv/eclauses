                  )}
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="n-cand">Date limite de remise des offres <span className="fr-text-default--error" aria-hidden="true">*</span></label>
                    <input id="n-cand" className="fr-input" type="date"
                            min={ymd(today())}
                            value={editForm[M.DLRO]} onChange={(e)=>setEditForm({...editForm, [M.DLRO]: e.target.value})}/>
                    {editErrors[M.DLRO] && <p className="fr-error-text">{editErrors[M.DLRO]}</p>}
                  </div>

                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="n-execend">Date de notification prévisionnelle <span className="fr-text-default--error" aria-hidden="true">*</span></label>
                    <input id="n-execend" className="fr-input" type="date"
                            value={editForm[M.DNOTPREV]} onChange={(e)=>setEditForm({...editForm, [M.DNOTPREV]: e.target.value})}/>
                    {editErrors[M.DNOTPREV] && <p className="fr-error-text">{editErrors[M.DNOTPREV]}</p>}
                  </div>
                  {editingKind !== 'parent' && (
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="n-execend">Date de fin d'exécution prévisionnelle</label>
                    <input id="n-execend" className="fr-input" type="date"
                            value={editForm[M.EXEC_END]} onChange={(e)=>setEditForm({...editForm, [M.EXEC_END]: e.target.value})}/>
                    {editErrors[M.EXEC_END] && <p className="fr-error-text">{editErrors[M.EXEC_END]}</p>}
                  </div>
                  )}
                  <div className="fr-btns-group fr-btns-group--inline fr-btns-group--right fr-mt-2w">
                    <button className="fr-btn" onClick={() => saveEdit(editingId)} disabled={savingId != null}>
                      {savingId===editingId || savingId === 'lot-create' ? 'Enregistrement…' : (editingKind === 'lot-create' ? 'Ajouter le lot' : 'Enregistrer')}
                    </button>
                    <button className="fr-btn fr-btn--secondary" onClick={closeEditModal}>
                      Annuler
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ==== MODALE INVITATION ==== */}
      {modalInviteOpen && (
        <div role="dialog" aria-modal="true" aria-labelledby="invite-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeInviteModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'720px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="invite-modal-title" className="fr-h4 fr-mb-0">Déclarer le titulaire</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeInviteModal}>Fermer</button>
                </div>
              </div>

               {!hasInvited && (
                <>
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="invite-email">E-mail du titulaire</label>
                    <input id="invite-email" className="fr-input" type="email" placeholder="email@domaine.fr"
                          value={inviteEmail} onChange={(e)=>setInviteEmail(e.target.value)} />
                    {!emailOk(inviteEmail) && inviteEmail && <p className="fr-error-text">Adresse invalide.</p>}
                  </div>

                <div className="fr-btns-group fr-btns-group--right fr-mt-2w">
                  <button className="fr-btn" onClick={()=>inviteTitulaire(inviteFor)} disabled={inviting || !emailOk(inviteEmail)}>
                    {inviting ? 'Invitation…' : 'Déclarer le titulaire'}
                  </button>
                  <button className="fr-btn fr-btn--secondary" onClick={closeInviteModal}>Fermer</button>
                </div>
                </>
               )}
              
            </div>
          </div>
        </div>
      )}

      {/* ==== MODALE DÉCLARATION DE PUBLICATION ==== */}
      {modalPubOpen && (
        <div role="dialog" aria-modal="true" aria-labelledby="pub-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closePubModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'720px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="pub-modal-title" className="fr-h4 fr-mb-0">Déclarer la publication de la consultation</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closePubModal}>Fermer</button>
                </div>
              </div>

              {pubMarche && (
                <>
                <div className="fr-alert fr-alert--warning fr-mb-2w">
                  <p>Attention ! Veillez à vérifier les informations de ce marché, toute modification ultérieure nécessitera l'intervention du support Eclauses.</p>
                </div>
                {(() => {
                  const hasLotTitle = Boolean(pubMarche[M.INTITULE_LOT]);
                  const hasLotNumber = Boolean(pubMarche[M.LOT]);
                  return (
                    <>
                <dl className="fr-text--sm fr-mb-2w">
                  <dt className="fr-text--bold">Intitulé du marché</dt>
                  <dd>{pubMarche[M.INTITULE] || '—'}</dd>
                  {hasLotTitle && (
                    <>
                      <dt className="fr-text--bold">Intitulé du lot</dt>
                      <dd>{pubMarche[M.INTITULE_LOT] || '—'}</dd>
                    </>
                  )}
                  {hasLotNumber && (
                    <>
                      <dt className="fr-text--bold">Numéro de lot</dt>
                      <dd>{pubMarche[M.LOT] || '—'}</dd>
                    </>
                  )}
                  <dt className="fr-text--bold">Clause sociale</dt>
                  <dd>{clauseLabel(pubMarche[M.CLAUSE])}</dd>
                  <dt className="fr-text--bold">Lieu d’exécution</dt>
                  <dd>{pubMarche[M.ADR] || '—'}</dd>
                  <dt className="fr-text--bold">Date limite de remise des offres</dt>
                  <dd>{formatDateOrDash(pubMarche[M.DLRO])}</dd>
                  <dt className="fr-text--bold">Date de notification prévisionnelle</dt>
                  <dd>{formatDateOrDash(pubMarche[M.DNOTPREV])}</dd>
                  <dt className="fr-text--bold">Date de fin d'exécution prévisionnelle</dt>
                  <dd>{formatDateOrDash(pubMarche[M.EXEC_END])}</dd>
                </dl>
                    </>
                  );
                })()}
                </>
              )}

              <div className="fr-input-group">
                <label className="fr-label" htmlFor="pub-date">Date de publication <span className="fr-text-default--error" aria-hidden="true">*</span></label>
                <input
                  id="pub-date"
                  className="fr-input"
                  type="date"
                  value={pubDate}
                  onChange={(e)=>setPubDate(e.target.value)}
                />
              </div>

              <div className="fr-input-group">
                <label className="fr-label" htmlFor="pub-link">Lien vers les documents de consultation <span className="fr-text-default--error" aria-hidden="true">*</span></label>
                <input id="pub-link" className="fr-input" type="url" placeholder="https://…"
                       value={pubLink} onChange={(e)=>setPubLink(e.target.value)} />
              </div>

              <p className="fr-text--sm fr-mb-2w">
                    <span className="fr-text-default--error" aria-hidden="true">*</span> Champs obligatoires
                  </p>

              <div className="fr-btns-group fr-btns-group--right fr-mt-3w">
                <button className="fr-btn" onClick={()=>savePublication(pubFor)} disabled={!pubFor || !pubDate || !String(pubLink || '').trim()}>
                  Valider la publication
                </button>
                <button className="fr-btn fr-btn--secondary" onClick={closePubModal}>Annuler</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ==== MODALE VALIDATION DÉCLARATION ==== */}
      {modalDeclOpen && (
        <div role="dialog" aria-modal="true" aria-labelledby="decl-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeDeclModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'840px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="decl-modal-title" className="fr-h4 fr-mb-0">Déclaration des bénéficiaires</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeDeclModal}>Fermer</button>
                </div>
              </div>

              {declList.length === 0 ? (
                <div className="fr-callout"><p className="fr-callout__text">Aucun bénéficiaire déclaré pour ce marché.</p></div>
              ) : (
                <div className="fr-grid-row fr-grid-row--gutters">
                  {declList.map(d => {
                    const isE = toBool(d.Est_beneficiaire_eclauses);
                    const b = isE ? benefMap.get(d.Beneficiaire) : null;
                    const nom = isE ? (b?.NOM || b?.Nom || '—') : (d.Nom || '—');
                    const prenom = isE ? (b?.Prenom || b?.PRENOM || '—') : (d.Prenom || '—');
                    const email = isE ? (b?.Courriel || b?.Email || '—') : (d.Email || d.Courriel || '—');
                    const statut = d.Statut || '—';
                    return (
                      <div className="fr-col-12 fr-col-md-6" key={d.id}>
                        <div className="fr-card fr-card--sm">
                          <div className="fr-card__body">
                            <div className="fr-card__content">
                              <p className="fr-badge fr-badge--sm fr-mb-1w">{statut}</p>
                              <p className="fr-text--sm fr-mb-1w"><strong>Type :</strong> {isE ? 'Eclauses' : 'Externe'}</p>
                              <p className="fr-text--sm fr-mb-1w"><strong>Bénéficiaire :</strong> {`${prenom} ${nom}`.trim() || '—'}</p>
                              <p className="fr-text--sm fr-mb-0"><strong>Email :</strong> {email}</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}

              <div className="fr-btns-group fr-btns-group--right fr-mt-3w">
                <button className="fr-btn" onClick={validateDeclaration} disabled={validating || !declList.length}>
                  {validating ? 'Validation…' : 'Valider la déclaration'}
                </button>
                <button className="fr-btn fr-btn--secondary" onClick={closeDeclModal}>Annuler</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ==== MODALE SUPPRESSION ==== */}
      {deleteOpen && deleteRowItem && (
        <div role="dialog" aria-modal="true" aria-labelledby="delete-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeDeleteModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'640px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="delete-modal-title" className="fr-h4 fr-mb-0">Supprimer ce marché ?</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeDeleteModal}>Fermer</button>
                </div>
              </div>

              <p className="fr-text--sm">
                Vous êtes sur le point de supprimer <strong>{deleteRowItem[M.INTITULE_PROP] || deleteRowItem[M.INTITULE] || `Marché #${deleteRowItem.id}`}</strong>.
                Cette action est définitive.
              </p>

              <div className="fr-btns-group fr-btns-group--right fr-mt-3w">
                <button className="fr-btn fr-btn--secondary" onClick={closeDeleteModal} disabled={deletingId===deleteRowItem.id}>
                  Annuler
                </button>
                <button className="fr-btn fr-btn--danger" onClick={deleteRowConfirmed} disabled={deletingId===deleteRowItem.id}>
                  {deletingId===deleteRowItem.id ? 'Suppression…' : 'Supprimer'}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {detailOpen && detailRow && (
        <div role="dialog" aria-modal="true" aria-labelledby="detail-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeDetailModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'720px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="detail-modal-title" className="fr-h4 fr-mb-0">Détails du marché</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeDetailModal}>Fermer</button>
                </div>
              </div>

              <div className="fr-mb-2w">
                {renderStatus(detailRow[M.STATUS])}
              </div>

              <dl className="fr-text--sm">
                <dt className="fr-text--bold">Intitulé du marché</dt>
                <dd>{detailRow[M.INTITULE] || '—'}</dd>
                <dt className="fr-text--bold">Intitulé du lot</dt>
                <dd>{detailRow[M.INTITULE_LOT] || '—'}</dd>
                <dt className="fr-text--bold">Numéro de lot</dt>
                <dd>{detailRow[M.LOT] || '—'}</dd>
                <dt className="fr-text--bold">Clause sociale</dt>
                <dd>{clauseLabel(detailRow[M.CLAUSE])}</dd>
                <dt className="fr-text--bold">Lieu d’exécution</dt>
                <dd>{detailRow[M.ADR] || '—'}</dd>
                <dt className="fr-text--bold">Spécialités du marché</dt>
                <dd>
                  {asArray(detailRow[M.SPECS])
                    .filter((x) => x !== 'L' && x != null && x !== '')
                    .map((x) => {
                      const n = Number(x);
                      return Number.isFinite(n) ? n : x;
                    })
                    .map((id) => specLabel(id))
                    .join(', ') || '—'}
                </dd>
                <dt className="fr-text--bold">Date limite de remise des offres</dt>
                <dd>{formatDate(parseDate(detailRow[M.DLRO]))}</dd>
                <dt className="fr-text--bold">Date de notification prévisionnelle</dt>
                <dd>{formatDate(parseDate(detailRow[M.DNOTPREV]))}</dd>
                <dt className="fr-text--bold">Lien des documents de consultation</dt>
                <dd>
                  {detailRow[M.LIEN_DOCS] ? (
                    <a className="fr-link" href={detailRow[M.LIEN_DOCS]} target="_blank" rel="noreferrer">
                      Ouvrir le lien
                    </a>
                  ) : '—'}
                </dd>
              </dl>

              {['Clause validée', 'Clauses validées'].includes(String(detailRow[M.STATUS] || '')) && (
                <section className="fr-mt-3w">
                  <h3 className="fr-h6 fr-mb-2w">Bénéficiaires déclarés</h3>
                  {(() => {
                    const ids = Array.isArray(detailRow[M.BENEFICIAIRES])
                      ? detailRow[M.BENEFICIAIRES].filter(x => x !== 'L')
                      : [];
                    const list = (declRows || []).filter(d => ids.includes(d.id));
                    if (!list.length) {
                      return (
                        <div className="fr-callout">
                          <p className="fr-callout__text">Aucun bénéficiaire déclaré.</p>
                        </div>
                      );
                    }
                    return (
                      <div className="fr-grid-row fr-grid-row--gutters">
                        {list.map(d => {
                          const isE = toBool(d.Est_beneficiaire_eclauses);
                          const b = isE ? benefMap.get(d.Beneficiaire) : null;
                          const nom = isE ? (b?.NOM || b?.Nom || '—') : (d.Nom || '—');
                          const prenom = isE ? (b?.Prenom || b?.PRENOM || '—') : (d.Prenom || '—');
                          const email = isE ? (b?.Courriel || b?.Email || '—') : (d.Email || d.Courriel || '—');
                          const statut = String(d.Statut || 'déclaré');
                        const isValid = statut.toLowerCase() === 'validé';
                        return (
                          <div className="fr-col-12 fr-col-md-6" key={`decl-${d.id}`}>
                            <div className="fr-card fr-card--sm">
                              <div className="fr-card__body">
                                <div className="fr-card__content">
                                  <p className={`fr-badge fr-badge--sm ${isValid ? 'fr-badge--success' : 'fr-badge--info'} fr-mb-1w`}>{statut}</p>
                                  <p className="fr-text--sm fr-mb-1w"><strong>Type :</strong> {isE ? 'Eclauses' : 'Externe'}</p>
                                    <p className="fr-text--sm fr-mb-1w"><strong>Bénéficiaire :</strong> {`${prenom} ${nom}`.trim() || '—'}</p>
                                    <p className="fr-text--sm fr-mb-0"><strong>Email :</strong> {email}</p>
                                  </div>
                                </div>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    );
                  })()}
                </section>
              )}

              <div className="fr-btns-group fr-btns-group--right fr-mt-3w">
                <button className="fr-btn fr-btn--primary" onClick={closeDetailModal}>Fermer</button>
              </div>
            </div>
          </div>
        </div>
      )}

    </section>
  );
};
