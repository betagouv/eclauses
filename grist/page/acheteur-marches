  async function saveEdit(id) {
    setErr(null);
    setEditErrors({});
    const nextErrors = {};
    if (isBlank(editForm[M.INTITULE])) nextErrors[M.INTITULE] = 'Champ requis.';
    if (editingKind === 'lot' || editingKind === 'lot-create') {
      if (isBlank(editForm[M.LOT])) nextErrors[M.LOT] = 'Champ requis.';
      if (isBlank(editForm[M.INTITULE_LOT])) nextErrors[M.INTITULE_LOT] = 'Champ requis.';
      if (!editForm[M.CLAUSE]) nextErrors[M.CLAUSE] = 'Champ requis.';
      if (!Array.isArray(editForm[M.SPECS]) || !editForm[M.SPECS].length) nextErrors[M.SPECS] = 'Champ requis.';
      if (isBlank(editForm[M.ADR])) nextErrors[M.ADR] = 'Champ requis.';
    }
    if (isBlank(editForm[M.DLRO])) nextErrors[M.DLRO] = 'Champ requis.';
    if (isBlank(editForm[M.DNOTPREV])) nextErrors[M.DNOTPREV] = 'Champ requis.';
    if (!isValidDateStr(editForm[M.DLRO])) nextErrors[M.DLRO] = 'Format invalide (AAAA-MM-JJ).';
    const dlroDate = parseDate(editForm[M.DLRO]);
    if (dlroDate) {
      const dlro0 = new Date(dlroDate);
      dlro0.setHours(0, 0, 0, 0);
      if (dlro0 < today()) {
        nextErrors[M.DLRO] = 'La date limite de remise des offres ne peut pas être antérieure au jour J.';
      }
    }
    if (!isValidDateStr(editForm[M.DNOTPREV])) nextErrors[M.DNOTPREV] = 'Format invalide (AAAA-MM-JJ).';
    if (!isValidDateStr(editForm[M.EXEC_END])) nextErrors[M.EXEC_END] = 'Format invalide (AAAA-MM-JJ).';
    if (Object.keys(nextErrors).length) {
      setEditErrors(nextErrors);
      return;
    }
    try {
      setSavingId(id || 'lot-create');
      if (editingKind === 'lot-create') {
        if (!lotCreateFor?.id) return;
        await gristAPI.addRecord(T.M, {
          [M.INTITULE]: editForm[M.INTITULE] || null,
          [M.PARENT]: lotCreateFor.id,
          [M.ACHETEUR]: org.id,
          [M.INTITULE_LOT]: editForm[M.INTITULE_LOT] || null,
          [M.LOT]: editForm[M.LOT] || null,
          [M.CLAUSE]: editForm[M.CLAUSE] ? Number(editForm[M.CLAUSE]) : null,
          [M.SPECS]: toRefList(editForm[M.SPECS]),
          [M.ADR]: editForm[M.ADR] || null,
          [M.PUB]: editForm[M.PUB] || null,
          [M.DLRO]: editForm[M.DLRO] || null,
          [M.DNOTPREV]: editForm[M.DNOTPREV] || null,
          [M.EXEC_END]: editForm[M.EXEC_END] || null,
          [M.STATUS]: lotCreateFor[M.STATUS] || 'En attente de publication',
        });
        await reloadMine();
        closeEditModal();
        return;
      }
      const updates = {
        [M.INTITULE]: editForm[M.INTITULE] || null,
        [M.PUB]: editForm[M.PUB] || null,
        [M.DLRO]: editForm[M.DLRO] || null,
        [M.DNOTPREV]: editForm[M.DNOTPREV] || null,
        [M.EXEC_END]: editForm[M.EXEC_END] || null,
      };
      if (editingKind === 'lot') {
        updates[M.INTITULE_LOT] = editForm[M.INTITULE_LOT] || null;
        updates[M.LOT] = editForm[M.LOT] || null;
        updates[M.CLAUSE] = editForm[M.CLAUSE] ? Number(editForm[M.CLAUSE]) : null;
        updates[M.SPECS] = toRefList(editForm[M.SPECS]);
        updates[M.ADR] = editForm[M.ADR] || null;
      }
      await gristAPI.updateRecord(T.M, id, updates);
      if (editingKind === 'parent') {
        const lots = getLotsForParent(rowById.get(id));
        for (const lot of lots) {
          await gristAPI.updateRecord(T.M, lot.id, {
            [M.INTITULE]: editForm[M.INTITULE] || null,
            [M.PUB]: editForm[M.PUB] || null,
            [M.DLRO]: editForm[M.DLRO] || null,
            [M.DNOTPREV]: editForm[M.DNOTPREV] || null,
