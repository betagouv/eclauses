const Component = () => {
  const RESET_TABLE = 'Application_Password_Reset';
  const [email, setEmail] = React.useState('');
  const [status, setStatus] = React.useState({ state: 'idle', message: '' });

  React.useEffect(() => {
    document.title = 'Mot de passe oublié';
  }, []);

  const onSubmit = async (e) => {
    e.preventDefault();
    const value = email.trim();
    if (!value) {
      setStatus({ state: 'error', message: 'Merci de renseigner votre adresse e-mail.' });
      return;
    }
    if (!gristAPI?.helpers?.emailLooksOk(value)) {
      setStatus({ state: 'error', message: 'Adresse e-mail invalide.' });
      return;
    }
    try {
      setStatus({ state: 'loading', message: 'Envoi du lien…' });
      await gristAPI.addRecord(RESET_TABLE, { Email: value, Is_Reset: true });
      setStatus({ state: 'success', message: 'Si cet e-mail est connu, un lien de réinitialisation vient d’être envoyé.' });
    } catch (err) {
      console.error(err);
      setStatus({ state: 'error', message: 'Impossible d’enregistrer la demande. Réessayez dans quelques instants.' });
    }
  };

  return (
    <main className="fr-container fr-my-6w" style={{ maxWidth: 640 }}>
      <div className="fr-grid-row fr-grid-row--gutters">
        <div className="fr-col-12">
          <h1 className="fr-h3 fr-mb-2w">Mot de passe oublié</h1>
          <p className="fr-text--sm fr-mb-3w">
            Saisissez votre adresse e-mail. Vous recevrez un lien pour choisir un nouveau mot de passe.
          </p>
          <form className="fr-mb-4w" onSubmit={onSubmit}>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="email">Adresse e-mail</label>
              <input
                id="email"
                className="fr-input"
                type="email"
                autoComplete="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                required
              />
            </div>
            <div className="fr-btns-group fr-btns-group--inline fr-mt-3w">
              <button className="fr-btn" type="submit" disabled={status.state === 'loading'}>
                {status.state === 'loading' ? 'Envoi…' : 'Envoyer le lien'}
              </button>
            </div>
          </form>

          {status.state === 'success' && (
            <div className="fr-alert fr-alert--success">
              <p>{status.message}</p>
            </div>
          )}
          {status.state === 'error' && (
            <div className="fr-alert fr-alert--error">
              <p>{status.message}</p>
            </div>
          )}
          {status.state === 'idle' && (
            <div className="fr-alert fr-alert--info fr-alert--sm">
              <p>Un mail sera envoyé si l’adresse est reconnue.</p>
            </div>
          )}
        </div>
      </div>
    </main>
  );
};
