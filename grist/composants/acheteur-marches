const Component = () => {
  // ===== Tables / Colonnes (strict) =====
  const T = {
    UA: 'Utilisateurs_Acheteurs',
    ACH: 'Acheteurs',
    M:  'Marches',
    C:  'Clauses_sociales',
    // INIT: 'InitLink',              // ← plus utilisé
    INV: 'Invitation_Titulaire',      // ← NOUVELLE TABLE
  };

  const M = {
    INTITULE: 'Intitule',
    INTITULE_PROP: 'Intitule_propre',
    LOT: 'Numero_de_lot',
    ACHETEUR: 'Acheteur',
    CLAUSE: 'Clauses_sociales',
    ADR: 'Adresse_d_execution',
    PUB: 'Date_de_publication',
    DL_CAND: 'Date_limite_de_candidature',
    DL_REAL: 'Date_Limite_de_Realisation_de_l_Operation',
    EXEC_END: 'Date_de_fin_d_execution',

    TITULAIRE: 'Titulaire',
    BENEFICIAIRES: 'Beneficiaires',
  };

  const { toOptions, parseDate, formatDate, daysLeft } = gristAPI.helpers;

  const ymd = (v) => {
    if (!v) return '';
    const d = v instanceof Date ? v : parseDate(v);
    if (!d) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth()+1).padStart(2,'0');
    const da = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${da}`;
  };
  const today = () => { const d = new Date(); d.setHours(0,0,0,0); return d; };
  const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v||''));  

  // ===== State =====
  const [loading, setLoading] = React.useState(true);
  const [err, setErr] = React.useState(null);

  const [ua, setUA] = React.useState(null);
  const [org, setOrg] = React.useState(null);
  const [rows, setRows] = React.useState([]);

  const [clauses, setClauses] = React.useState([]);
  const [optsClauses, setOptsClauses] = React.useState([]);

  // Filtres globaux
  const [search, setSearch] = React.useState('');
  const [clauseFilter, setClauseFilter] = React.useState('');

  // Création
  const [newOpen, setNewOpen] = React.useState(false);
  const [creating, setCreating] = React.useState(false);
  const [newForm, setNewForm] = React.useState({
    [M.INTITULE]: '',
    [M.LOT]: '',
    [M.CLAUSE]: '',
    [M.ADR]: '',
    [M.PUB]: ymd(new Date()),
    [M.DL_CAND]: '',
    [M.DL_REAL]: '',
    [M.EXEC_END]: ''
  });

  // Édition (modale)
  const [editingId, setEditingId] = React.useState(null);
  const [editForm, setEditForm] = React.useState({});
  const [savingId, setSavingId] = React.useState(null);
  const [modalEditOpen, setModalEditOpen] = React.useState(false);

  // Invitation (modale)
  const [inviteFor, setInviteFor] = React.useState(null);
  const [inviteEmail, setInviteEmail] = React.useState('');
  const [inviting, setInviting] = React.useState(false);
  const [modalInviteOpen, setModalInviteOpen] = React.useState(false);
  const [inviteMsg, setInviteMsg] = React.useState(null);   // ← message court en cas de succès

  // Suppression
  const [deletingId, setDeletingId] = React.useState(null);

  React.useEffect(() => {
    (async () => {
      setLoading(true); setErr(null);
      const auth = gristAPI.getAuth();
      const roles = Array.isArray(auth?.roles) ? auth.roles : [];
      if (!auth || !roles.includes('acheteur') || !auth.acheteurId) {
        setErr("Accès refusé : rôle 'acheteur' requis.");
        setLoading(false);
        return;
      }

      const uaRows = await gristAPI.getData(T.UA);
      const me = uaRows.find(r => r.id === auth.acheteurId);
      if (!me?.Entite_de_rattachement) {
        setErr("Votre compte n'est rattaché à aucune entité acheteuse.");
        setLoading(false);
        return;
      }
      setUA(me);

      const achRows = await gristAPI.getData(T.ACH);
      const entite = achRows.find(a => a.id === me.Entite_de_rattachement);
      if (!entite) {
        setErr("Entité acheteuse introuvable.");
        setLoading(false);
        return;
      }
      setOrg(entite);

      const c = await gristAPI.getData(T.C);
      setClauses(c || []);
      setOptsClauses(toOptions(c || []));

      const ms = await gristAPI.getData(T.M);
      const mine = (ms || []).filter(m => m[M.ACHETEUR] === entite.id);
      setRows(mine);

      setLoading(false);
    })();
  }, []);

  const clauseLabel = React.useCallback((id) => {
    const o = optsClauses.find(x => x.value === id);
    return o ? o.label : String(id ?? '—');
  }, [optsClauses]);

  const applyCommonFilters = React.useCallback((list) => {
    const s = (search || '').toLowerCase();
    const cf = clauseFilter ? Number(clauseFilter) : null;

    return list.filter(r => {
      if (cf !== null && r[M.CLAUSE] !== cf) return false;
      if (s) {
        const hay = [
          r[M.INTITULE_PROP] || '',
          r[M.INTITULE] || '',
          r[M.ADR] || '',
          r[M.LOT] || '',
          clauseLabel(r[M.CLAUSE])
        ].join(' • ').toLowerCase();
        if (!hay.includes(s)) return false;
      }
      return true;
    });
  }, [search, clauseFilter, clauseLabel]);

  const today0 = today();

  const lists = React.useMemo(() => {
    const base = Array.isArray(rows) ? rows : [];

    const consultation = [];
    const execution = [];
    const archives = [];

    base.forEach(r => {
      const dCand = parseDate(r[M.DL_CAND]);
      const dExecEnd = parseDate(r[M.EXEC_END]);
      if (dCand && dCand >= today0) { consultation.push(r); return; }
      if (dCand && dCand < today0 && dExecEnd && dExecEnd >= today0) { execution.push(r); return; }
      if (dExecEnd && dExecEnd < today0) { archives.push(r); }
    });

    consultation.sort((a,b) => (parseDate(a[M.DL_CAND])?.getTime()||0) - (parseDate(b[M.DL_CAND])?.getTime()||0));
    execution.sort((a,b) => (parseDate(a[M.EXEC_END])?.getTime()||0) - (parseDate(b[M.EXEC_END])?.getTime()||0));
    archives.sort((a,b) => (parseDate(b[M.EXEC_END])?.getTime()||0) - (parseDate(a[M.EXEC_END])?.getTime()||0));

    return {
      consultation: applyCommonFilters(consultation),
      execution: applyCommonFilters(execution),
      archives: applyCommonFilters(archives),
    };
  }, [rows, today0, applyCommonFilters]);

  // ===== CRUD =====
  const resetNewForm = () => setNewForm({
    [M.INTITULE]: '',
    [M.LOT]: '',
    [M.CLAUSE]: '',
    [M.ADR]: '',
    [M.PUB]: ymd(new Date()),
    [M.DL_CAND]: '',
    [M.DL_REAL]: '',
    [M.EXEC_END]: ''
  });

  async function reloadMine() {
    const ms = await gristAPI.getData(T.M);
    setRows((ms || []).filter(m => m[M.ACHETEUR] === org.id));
  }

  async function createMarche() {
    if (!org) return;
    setErr(null);
    const payload = {
      [M.INTITULE]: newForm[M.INTITULE] || null,
      [M.LOT]: newForm[M.LOT] || null,
      [M.CLAUSE]: newForm[M.CLAUSE] ? Number(newForm[M.CLAUSE]) : null,
      [M.ADR]: newForm[M.ADR] || null,
      [M.PUB]: newForm[M.PUB] || null,
      [M.DL_CAND]: newForm[M.DL_CAND] || null,
      [M.DL_REAL]: newForm[M.DL_REAL] || null,
      [M.EXEC_END]: newForm[M.EXEC_END] || null
    };
    try {
      setCreating(true);
      await gristAPI.addRecord(T.M, payload);
      await reloadMine();
      setNewOpen(false);
      resetNewForm();
    } catch (e) {
      setErr(e.message || "Échec de création du marché.");
    } finally {
      setCreating(false);
    }
  }

  // Édition via modale
  function openEditModal(row) {
    setEditingId(row.id);
    setEditForm({
      [M.INTITULE]: row[M.INTITULE] || '',
      [M.LOT]: row[M.LOT] || '',
      [M.CLAUSE]: row[M.CLAUSE] || '',
      [M.ADR]: row[M.ADR] || '',
      [M.PUB]: ymd(row[M.PUB]),
      [M.DL_CAND]: ymd(row[M.DL_CAND]),
      [M.DL_REAL]: ymd(row[M.DL_REAL]),
      [M.EXEC_END]: ymd(row[M.EXEC_END]),
    });
    setModalEditOpen(true);
  }
  function closeEditModal() {
    setModalEditOpen(false);
    setEditingId(null);
    setEditForm({});
  }
  async function saveEdit(id) {
    setErr(null);
    try {
      setSavingId(id);
      const updates = {
        [M.INTITULE]: editForm[M.INTITULE] || null,
        [M.LOT]: editForm[M.LOT] || null,
        [M.CLAUSE]: editForm[M.CLAUSE] ? Number(editForm[M.CLAUSE]) : null,
        [M.ADR]: editForm[M.ADR] || null,
        [M.PUB]: editForm[M.PUB] || null,
        [M.DL_CAND]: editForm[M.DL_CAND] || null,
        [M.DL_REAL]: editForm[M.DL_REAL] || null,
        [M.EXEC_END]: editForm[M.EXEC_END] || null,
      };
      await gristAPI.updateRecord(T.M, id, updates);
      await reloadMine();
      closeEditModal();
    } catch (e) {
      setErr(e.message || 'Échec de la sauvegarde.');
    } finally {
      setSavingId(null);
    }
  }

  // Invitation via modale → écrit dans Invitation_Titulaire
  function openInviteModal(row) {
    setInviteFor(row.id);
    setInviteEmail('');
    setInviteMsg(null);
    setModalInviteOpen(true);
  }
  function closeInviteModal() {
    setModalInviteOpen(false);
    setInviteFor(null);
    setInviteEmail('');
    setInviteMsg(null);
  }
  async function inviteTitulaire(marcheId) {
    if (!emailOk(inviteEmail)) {
      setErr("Adresse e-mail titulaire invalide.");
      return;
    }
    try {
      setInviting(true);
      // ⬇️ Remplace InitLink par Invitation_Titulaire : Grist génère le Token
      await gristAPI.addRecord(T.INV, { Marche: marcheId, Email: inviteEmail });
      setInviteMsg("Invitation enregistrée. Un e-mail sera envoyé automatiquement.");
      // tu peux garder la modale ouverte pour afficher le message
      // ou refermer après un court délai :
       setTimeout(closeInviteModal, 1200);
    } catch (e) {
      setErr(e.message || "Impossible d’enregistrer l’invitation.");
    } finally {
      setInviting(false);
    }
  }

  async function deleteRow(id) {
    if (!confirm('Supprimer ce marché ?')) return;
    setErr(null);
    try {
      setDeletingId(id);
      await gristAPI.deleteRecord(T.M, id);
      setRows(rows.filter(r => r.id !== id));
    } catch (e) {
      setErr(e.message || 'Suppression impossible.');
    } finally {
      setDeletingId(null);
    }
  }

  // ===== Lignes =====
  function RowViewConsultation({r}) {
    const dReal = parseDate(r[M.DL_REAL]);
    const aa = r[M.INTITULE_PROP] || r[M.INTITULE] || '—';
    return (
      <tr>
        <td><strong>{aa}</strong></td>
        <td>{dReal ? formatDate(dReal) : '—'}</td>
        <td>0</td>
        <td>35</td>
        <td>4</td>
        <td className="fr-text--right">
          <div className="fr-btns-group fr-btns-group--inline fr-btns-group--icon-left fr-btns-group--sm fr-ml-auto">
            <button className="fr-btn fr-btn--sm fr-icon-edit-line fr-btn--tertiary " onClick={()=>openEditModal(r)}>
              Modifier
            </button>
            <button className="fr-btn fr-btn--sm fr-icon-delete-bin-line fr-btn--tertiary" onClick={()=>deleteRow(r.id)} disabled={deletingId===r.id}>
              Supprimer
            </button>
          </div>
        </td>
      </tr>
    );
  }

  function RowViewExecution({r}) {
    const dExecEnd = parseDate(r[M.EXEC_END]);
    const aa = r[M.INTITULE_PROP] || r[M.INTITULE] || '—';
    const titulaire = r[M.TITULAIRE];
    const beneficiaires = r[M.BENEFICIAIRES].filter((x)=>x!=='L');
    const beneficiaires_txt = beneficiaires.join(', ');
    return (
      <tr>
        <td><strong>{aa}</strong></td>
        <td>{dExecEnd ? formatDate(dExecEnd) : '—'}</td>
        <td>{titulaire}</td>
        <td>{beneficiaires.length == 0 ? (
            <span className="fr-badge fr-badge--warning">Aucun bénéficiaire déclaré</span>
        ) : (
           <>{beneficiaires_txt}</>
        )}</td>
        <td className="fr-text--right">
          <div className="fr-btns-group fr-btns-group--inline fr-btns-group--icon-left fr-btns-group--sm fr-ml-auto">
          {!titulaire && (
            <button className="fr-btn fr-icon-user-add-line fr-btn--sm fr-btn--secondary" onClick={()=>openInviteModal(r)}>
              Déclarer le titulaire
            </button>
          )}
          {beneficiaires.length == 0 && (
            <button className="fr-btn fr-icon-user-add-line fr-btn--sm fr-btn--secondary" onClick={()=>{alert("TODO titulaire relancer")}}>
              Relancer le titulaire
            </button>
          )}

          {titulaire && beneficiaires.length > 0 && (
            <span className="fr-badge fr-badge--success">Clause sociale validé</span>
          )}
            
            <button className="fr-btn fr-btn--tertiary fr-icon-edit-line fr-btn--sm" onClick={()=>openEditModal(r)}>
              Modifier
            </button>
          </div>
        </td>
      </tr>
    );
  }

  function RowViewArchived({r}) {
    const dExecEnd = parseDate(r[M.EXEC_END]);
    const aa = r[M.INTITULE_PROP] || r[M.INTITULE] || '—';
    const titulaire = r[M.TITULAIRE];
    const beneficiaires = r[M.BENEFICIAIRES].filter((x)=>x!=='L');
    const beneficiaires_txt = beneficiaires.join(', ');
    return (
      <tr>
        <td><strong>{aa}</strong></td>
        <td>{dExecEnd ? formatDate(dExecEnd) : '—'}</td>
        <td>{titulaire}</td>
        <td>{beneficiaires_txt}</td>
      </tr>
    );
  }

  // ===== UI =====
  if (loading) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-loader" aria-label="Chargement" />
        <p className="fr-text--sm fr-mt-1w">Chargement des marchés…</p>
      </section>
    );
  }

  if (err) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--error"><p><strong>Erreur :</strong> {err}</p></div>
      </section>
    );
  }

  return (
    <section className="fr-container fr-my-6w">
      <header className="fr-mb-4w">
        <h1 className="fr-h3 fr-mb-1w">Mes marchés</h1>
      </header>

      <div className="fr-callout">
        <h3 className="fr-callout__title">Créer un marché</h3>
        <p className="fr-callout__text">Déclarer un nouveau marché couvert par une clause sociale.</p>
        <button className="fr-btn" onClick={()=>setNewOpen(!newOpen)}>
          {newOpen ? 'Fermer' : 'Afficher le formulaire'}
        </button>
      </div>

      {/* Création */}
      {newOpen && (
        <div className="fr-grid-row fr-grid-row--gutters fr-mt-2w fr-mb-4w">
          <div className="fr-col-12 fr-col-lg-6">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-intitule">Intitulé</label>
              <input id="n-intitule" className="fr-input" type="text"
                     value={newForm[M.INTITULE]} onChange={(e)=>setNewForm({...newForm, [M.INTITULE]: e.target.value})}/>
            </div>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-lot">Numéro de lot</label>
              <input id="n-lot" className="fr-input" type="text"
                     value={newForm[M.LOT]} onChange={(e)=>setNewForm({...newForm, [M.LOT]: e.target.value})}/>
            </div>
            <div className="fr-select-group">
              <label className="fr-label" htmlFor="n-clause">Clause sociale</label>
              <select id="n-clause" className="fr-select"
                      value={newForm[M.CLAUSE]} onChange={(e)=>setNewForm({...newForm, [M.CLAUSE]: e.target.value})}>
                <option value="">—</option>
                {optsClauses.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
            </div>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-adr">Lieu d’exécution</label>
              <input id="n-adr" className="fr-input" type="text"
                     value={newForm[M.ADR]} onChange={(e)=>setNewForm({...newForm, [M.ADR]: e.target.value})}/>
            </div>
          </div>

          <div className="fr-col-12 fr-col-lg-6">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-pub">Date de publication</label>
              <input id="n-pub" className="fr-input" type="date"
                     value={newForm[M.PUB]} onChange={(e)=>setNewForm({...newForm, [M.PUB]: e.target.value})}/>
            </div>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-real">Date limite de remise des offres (DLRO)</label>
              <input id="n-real" className="fr-input" type="date"
                     value={newForm[M.DL_REAL]} onChange={(e)=>setNewForm({...newForm, [M.DL_REAL]: e.target.value})}/>
            </div>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="n-execend">Fin d’exécution prévisionnelle</label>
              <input id="n-execend" className="fr-input" type="date"
                     value={newForm[M.EXEC_END]} onChange={(e)=>setNewForm({...newForm, [M.EXEC_END]: e.target.value})}/>
            </div>

            <div className="fr-btns-group fr-btns-group--inline fr-mt-2w">
              <button className="fr-btn" onClick={createMarche} disabled={creating}>
                {creating ? 'Création…' : 'Créer'}
              </button>
              <button className="fr-btn fr-btn--secondary" onClick={()=>{setNewOpen(false); resetNewForm();}} disabled={creating}>
                Annuler
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Filtres globaux */}
      <div className="fr-grid-row fr-grid-row--gutters fr-mb-3w">
        <div className="fr-col-12 fr-col-md-6">
          <div className="fr-input-group">
            <label className="fr-label" htmlFor="search">Rechercher</label>
            <input id="search" className="fr-input" type="search" placeholder="Intitulé, lot, adresse, clause…"
                   value={search} onChange={(e)=>setSearch(e.target.value)} />
          </div>
        </div>
        <div className="fr-col-12 fr-col-md-6">
          <div className="fr-select-group">
            <label className="fr-label" htmlFor="f-clause">Filtrer par clause</label>
            <select id="f-clause" className="fr-select"
                    value={clauseFilter} onChange={(e)=>setClauseFilter(e.target.value)}>
              <option value="">— toutes —</option>
              {optsClauses.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </div>
      </div>

      {/* TABLEAU 1 : En cours de consultation */}
      <section className="fr-mb-6w">
        <h2 className="fr-h4 fr-mb-2w">En cours de consultation</h2>
        {lists.consultation.length === 0 ? (
          <div className="fr-callout"><p className="fr-callout__text">Aucun marché en cours de consultation.</p></div>
        ) : (
          <div className="fr-table">
            <table>
              <thead>
                <tr>
                  <th>Intitulé</th>
                  <th>Date limite de remise des offres</th>
                  <th>Candidats en cours de recherche de bénéficiaires</th>
                  <th>Bénéficiaires potentiels sur la spécialité</th>
                  <th>Bénéficiaires intéressés par le marché</th>
                  <th className="fr-text--right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {lists.consultation.map(r => <RowViewConsultation key={r.id} r={r}/>)}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {/* TABLEAU 2 : En cours d’exécution */}
      <section className="fr-mb-6w">
        <h2 className="fr-h4 fr-mb-2w">En attente de déclaration des bénéficiaires</h2>
        {lists.execution.length === 0 ? (
          <div className="fr-callout"><p className="fr-callout__text">Aucun marché en cours d’exécution.</p></div>
        ) : (
          <div className="fr-table">
            <table>
              <thead>
                <tr>
                  <th>Intitulé</th>
                  <th>Date prévisionnel de fin d’exécution</th>
                  <th>Nom du titulaire</th>
                  <th>Bénéficiaire(s) retenu(s)</th>
                  <th className="fr-text--right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {lists.execution.map(r => <RowViewExecution key={r.id} r={r} />)}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {/* TABLEAU 3 : Archivés */}
      <section className="fr-mb-6w">
        <h2 className="fr-h4 fr-mb-2w">Marchés avec clauses sociales validées</h2>
        {lists.archives.length === 0 ? (
          <div className="fr-callout"><p className="fr-callout__text">Aucun marché terminés.</p></div>
        ) : (
          <div className="fr-table">
            <table>
              <thead>
                <tr>
                  <th>Intitulé</th>
                  <th>Fin d’exécution prévisionnelle</th>
                  <th>Nom du titulaire</th>
                  <th>Bénéficiaire(s) retenu(s)</th>
                </tr>
              </thead>
              <tbody>
                {lists.archives.map(r => <RowViewArchived key={r.id} r={r} />)}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {/* ==== MODALE ÉDITION ==== */}
      {modalEditOpen && (
        <div role="dialog" aria-modal="true" aria-labelledby="edit-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeEditModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'960px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="edit-modal-title" className="fr-h4 fr-mb-0">Modifier le marché</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeEditModal}>Fermer</button>
                </div>
              </div>

              <div className="fr-grid-row fr-grid-row--gutters">
                <div className="fr-col-12 fr-col-lg-6">
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="e-intitule">Intitulé</label>
                    <input id="e-intitule" className="fr-input" type="text"
                           value={editForm[M.INTITULE] || ''} onChange={(e)=>setEditForm({...editForm,[M.INTITULE]:e.target.value})}/>
                  </div>
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="e-lot">Numéro de lot</label>
                    <input id="e-lot" className="fr-input" type="text"
                           value={editForm[M.LOT] || ''} onChange={(e)=>setEditForm({...editForm,[M.LOT]:e.target.value})}/>
                  </div>
                  <div className="fr-select-group">
                    <label className="fr-label" htmlFor="e-clause">Clause sociale</label>
                    <select id="e-clause" className="fr-select"
                            value={String(editForm[M.CLAUSE] || '')}
                            onChange={(e)=>setEditForm({...editForm,[M.CLAUSE]:e.target.value})}>
                      <option value="">—</option>
                      {optsClauses.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                    </select>
                  </div>
                </div>

                <div className="fr-col-12 fr-col-lg-6">
                  <div className="fr-input-group">
                    <label className="fr-label" htmlFor="e-adr">Lieu d’exécution</label>
                    <input id="e-adr" className="fr-input" type="text"
                           value={editForm[M.ADR] || ''} onChange={(e)=>setEditForm({...editForm,[M.ADR]:e.target.value})}/>
                  </div>
                  <div className="fr-grid-row fr-grid-row--gutters">
                    <div className="fr-col-12 fr-col-md-6">
                      <div className="fr-input-group">
                        <label className="fr-label" htmlFor="e-pub">Publication</label>
                        <input id="e-pub" className="fr-input" type="date"
                               value={editForm[M.PUB] || ''} onChange={(e)=>setEditForm({...editForm,[M.PUB]:e.target.value})}/>
                      </div>
                    </div>
                    <div className="fr-col-12 fr-col-md-6">
                      <div className="fr-input-group">
                        <label className="fr-label" htmlFor="e-cand">Limite candidature</label>
                        <input id="e-cand" className="fr-input" type="date"
                               value={editForm[M.DL_CAND] || ''} onChange={(e)=>setEditForm({...editForm,[M.DL_CAND]:e.target.value})}/>
                      </div>
                    </div>
                    <div className="fr-col-12 fr-col-md-6">
                      <div className="fr-input-group">
                        <label className="fr-label" htmlFor="e-real">DLRO</label>
                        <input id="e-real" className="fr-input" type="date"
                               value={editForm[M.DL_REAL] || ''} onChange={(e)=>setEditForm({...editForm,[M.DL_REAL]:e.target.value})}/>
                      </div>
                    </div>
                    <div className="fr-col-12 fr-col-md-6">
                      <div className="fr-input-group">
                        <label className="fr-label" htmlFor="e-exec">Fin d’exécution</label>
                        <input id="e-exec" className="fr-input" type="date"
                               value={editForm[M.EXEC_END] || ''} onChange={(e)=>setEditForm({...editForm,[M.EXEC_END]:e.target.value})}/>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div className="fr-btns-group fr-btns-group--right fr-mt-2w">
                <button className="fr-btn" onClick={()=>saveEdit(editingId)} disabled={savingId===editingId}>
                  {savingId===editingId ? 'Enregistrement…' : 'Enregistrer'}
                </button>
                <button className="fr-btn fr-btn--secondary" onClick={closeEditModal}>Annuler</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ==== MODALE INVITATION ==== */}
      {modalInviteOpen && (
        <div role="dialog" aria-modal="true" aria-labelledby="invite-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999,
                      display:'flex', alignItems:'center', justifyContent:'center',
                      padding:'1rem', overflow:'auto' }}
             onClick={closeInviteModal}>
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'720px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w"
                 style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="invite-modal-title" className="fr-h4 fr-mb-0">Déclarer le titulaire</h2>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={closeInviteModal}>Fermer</button>
                </div>
              </div>

              {inviteMsg && <div className="fr-alert fr-alert--success fr-mb-2w"><p>{inviteMsg}</p></div>}

              <div className="fr-input-group">
                <label className="fr-label" htmlFor="invite-email">E-mail du titulaire</label>
                <input id="invite-email" className="fr-input" type="email" placeholder="email@domaine.fr"
                       value={inviteEmail} onChange={(e)=>setInviteEmail(e.target.value)} />
                {!emailOk(inviteEmail) && inviteEmail && <p className="fr-error-text">Adresse invalide.</p>}
              </div>

              <div className="fr-btns-group fr-btns-group--right fr-mt-2w">
                <button className="fr-btn" onClick={()=>inviteTitulaire(inviteFor)} disabled={inviting || !emailOk(inviteEmail)}>
                  {inviting ? 'Invitation…' : 'Enregistrer l’invitation'}
                </button>
                <button className="fr-btn fr-btn--secondary" onClick={closeInviteModal}>Fermer</button>
              </div>
            </div>
          </div>
        </div>
      )}

    </section>
  );
};
