const Component = () => {
  // ===== Tables / colonnes =====
  const T = {
    REP: 'Repondants',
    M: 'Marches',
    C: 'Clauses_sociales',
    B: 'Beneficiaires',
    LOG: 'Acces_Coordonnees',
  };

  const R = {
    CAND_LIST: 'Candidat_aux_marches',  // RefList(Marches)
    TIT_LIST:  'Titulaire_aux_marches', // RefList(Marches)
    NOM: 'Nom', PRENOM: 'Prenom',
  };

  const M = {
    INTITULE: 'Intitule',
    INTIT_PROPRE: 'Intitule_propre',
    CLAUSE: 'Clauses_sociales',         // Ref -> Clauses_sociales
  };

  const B = {
    NOM: 'NOM',
    PRENOM: 'Prenom',
    EMAIL: 'Courriel',
    TEL: 'Telephone',
    AUTRES: 'Autres_informations',
    CLAUSES: 'Clauses_sociales_de_rattachement', // RefList(Clauses_sociales)
    SPECIALITE_ECOLE: 'Specialite_ecole',
    DEPARTEMENTS: 'Departement_de_residence',
    REGIONS_MOB: 'Regions_ou_vous_etes_mobile',
    CV: 'curriculum_vitae',
    FORMATION: 'Formation',
    ANNEE_DIP: 'Annee_de_diplome',
    SPECS: 'Specialite',
    SOUS_SPEC: 'Sous_specialite',
    MEMOIRE: 'Intitule_du_memoire',
  };

  const LOG = {
    REP: 'Repondant',
    MARCHE: 'Marche',
    BENEF: 'Beneficiaire',
    AFF_EMAIL: 'Affiche_email',
    AFF_TEL: 'Affiche_telephone',
  };

  // ===== Utils =====
  const asArray = (v) => Array.isArray(v) ? v : (v == null ? [] : [v]);
  const norm = (s) => String(s || '').toLowerCase();
  const includesI = (h, n) => norm(h).includes(norm(n));
  const isNum = (x) => typeof x === 'number' && isFinite(x);

  function pickLabelField(rows) {
    if (!rows || !rows.length) return 'id';
    const s = rows[0] || {};
    const pref = ['Intitule','Intitulé','Nom','nom','label','name','title','Title','Libellé','Libelle','libelle'];
    for (const k of pref) if (typeof s[k] === 'string') return k;
    for (const k of Object.keys(s)) if (typeof s[k] === 'string') return k;
    return 'id';
  }
  function toOptions(rows) {
    const key = pickLabelField(rows);
    return (rows || []).map(r => ({ value: r.id, label: String(r[key] ?? r.id) }));
  }
  const labelFrom = (opts, id) => (opts.find(o => o.value === id)?.label ?? String(id ?? '—'));
  const fullName = (r) => {
    const n = (r[B.NOM] || '').trim(); const p = (r[B.PRENOM] || '').trim();
    return (p && n) ? `${p} ${n}` : (p || n || 'Sans nom');
  };

  // ===== State =====
  const [loading, setLoading] = React.useState(true);
  const [err, setErr] = React.useState(null);

  const [repRows, setRepRows] = React.useState([]);
  const [marchesRows, setMarchesRows] = React.useState([]);
  const [clauseRows, setClauseRows] = React.useState([]);
  const [benefRows, setBenefRows] = React.useState([]);

  const [currentRepId, setCurrentRepId] = React.useState(null);
  const [me, setMe] = React.useState(null);

  const [optsMarches, setOptsMarches] = React.useState([]);
  const [optsClauses, setOptsClauses] = React.useState([]);

  // Marché choisi
  const [selectedMarcheId, setSelectedMarcheId] = React.useState('');

  // Recherche
  const [search, setSearch] = React.useState('');

  // Modale fiche
  const [modalOpen, setModalOpen] = React.useState(false);
  const [modalRow, setModalRow]   = React.useState(null);
  const [revealedFor, setRevealedFor] = React.useState(new Set()); // benefId -> coordonnées visibles (session)

  // ===== Load =====
  React.useEffect(() => {
    let alive = true;
    (async () => {
      try {
        setLoading(true); setErr(null);

        const auth = gristAPI.getAuth ? gristAPI.getAuth() : null;
        if (!auth || !Array.isArray(auth.roles) || !auth.roles.includes('repondant')) {
          throw new Error("Accès refusé : rôle 'répondant' requis.");
        }

        const [rep, m, c, b] = await Promise.all([
          gristAPI.getData(T.REP),
          gristAPI.getData(T.M),
          gristAPI.getData(T.C),
          gristAPI.getData(T.B),
        ]);
        if (!alive) return;

        setRepRows(Array.isArray(rep) ? rep : []);
        setMarchesRows(Array.isArray(m) ? m : []);
        setClauseRows(Array.isArray(c) ? c : []);
        setBenefRows(Array.isArray(b) ? b : []);
        setOptsClauses(toOptions(c || []));

        // identifie le répondant
        let id = auth.repondantId || null;
        if (!id && rep && rep.length === 1) id = rep[0].id;
        if (!id) throw new Error("Impossible d’identifier votre fiche répondant.");
        setCurrentRepId(id);

        const mine = (rep || []).find(r => r.id === id);
        if (!mine) throw new Error("Votre fiche n’est pas accessible.");
        setMe(mine);

        // options marchés (candidats + titulaires)
        const ids = [...new Set([...asArray(mine[R.CAND_LIST]), ...asArray(mine[R.TIT_LIST])].filter(isNum))];
        const ms = (m || []).filter(row => ids.includes(row.id));
        setOptsMarches(toOptions(ms));
        // pré-sélection : premier marché si existant
        //if (ms.length) setSelectedMarcheId(String(ms[0].id));
      } catch (e) {
        if (!alive) return;
        setErr(e.message || 'Erreur de chargement');
      } finally {
        if (alive) setLoading(false);
      }
    })();
    return () => { alive = false; };
  }, []);

  // Clause du marché sélectionné
  const selectedMarche = React.useMemo(
    () => (marchesRows || []).find(m => String(m.id) === String(selectedMarcheId)) || null,
    [marchesRows, selectedMarcheId]
  );
  const selectedClauseId = selectedMarche ? selectedMarche[M.CLAUSE] : null;

  // Liste filtrée des bénéficiaires (par clause du marché + recherche)
  const filteredBenefs = React.useMemo(() => {
    if (!selectedClauseId) return [];
    const q = norm(search);
    return (benefRows || [])
      .filter(b => asArray(b[B.CLAUSES]).includes(selectedClauseId))
      .filter(b => {
        if (!q) return true;
        return includesI(b[B.NOM] || '', q) ||
               includesI(b[B.PRENOM] || '', q) ||
               includesI(b[B.EMAIL] || '', q) ||
               includesI(b[B.SPECIALITE_ECOLE] || '', q) ||
               includesI(b[B.AUTRES] || '', q);
      })
      .sort((a, b) => fullName(a).localeCompare(fullName(b), 'fr', {sensitivity:'base'}));
  }, [benefRows, selectedClauseId, search]);

  // === Modale fiche ===
  async function openModal(row) { 

    let token = "";
    let baseUrl = "";

    await grist.docApi.getAccessToken({ readOnly: true }).then(response => {
      token = response.token;
      baseUrl = response.baseUrl;
    });

    let cv = row[B.CV]?.filter((x)=>x!=='L')[0]

    if(cv == undefined){
        row.cv_url = undefined
    }
    else{
        const url = `${baseUrl}/attachments/${cv}/download?auth=${token}`;

        row.cv_url = url
    }

    setModalRow(row); setModalOpen(true); 
    
    }
  function closeModal()    { setModalOpen(false); setModalRow(null); }

  async function revealContacts(benefId) {
    if (!currentRepId || !selectedMarcheId || !isNum(benefId)) return;
    try {
      // log en base
      await gristAPI.addRecord(T.LOG, {
        [LOG.REP]: currentRepId,
        [LOG.MARCHE]: Number(selectedMarcheId),
        [LOG.BENEF]: benefId,
        [LOG.AFF_EMAIL]: true,
        [LOG.AFF_TEL]: true,
      });
      // mémorise côté client (session)
      const next = new Set(revealedFor); next.add(benefId); setRevealedFor(next);
    } catch (e) {
      setErr(e.message || "Impossible d’enregistrer l’accès aux coordonnées.");
    }
  }

  // ===== UI =====
  if (loading) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-loader" aria-label="Chargement" />
        <p className="fr-text--sm fr-mt-1w">Chargement…</p>
      </section>
    );
  }
  if (err) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--error"><p><strong>Erreur :</strong> {err}</p></div>
      </section>
    );
  }
  if (!me || !currentRepId) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--warning"><p>Fiche répondant introuvable.</p></div>
      </section>
    );
  }

  return (
    <section className="fr-container fr-my-6w">
      <header className="fr-mb-3w">
        <h1 className="fr-h3 fr-mb-1w">Recherche de bénéficiaires</h1>
        <p className="fr-text--sm fr-text-mention--grey">
          Choisissez un marché (candidat ou titulaire), puis consultez les bénéficiaires de sa clause sociale.
        </p>
      </header>

      {/* Sélection du marché */}
      <div className="fr-grid-row fr-grid-row--gutters fr-mb-3w">
        <div className="fr-col-12 fr-col-md-6">
          <div className="fr-select-group">
            <label className="fr-label" htmlFor="marche">Marché</label>
            <select id="marche" className="fr-select"
                    value={selectedMarcheId}
                    onChange={(e)=>setSelectedMarcheId(e.target.value)}>
              {optsMarches.length ? 
                    <option value="">— Sélectionné un marché —</option> : <option value="">— Aucun marché accessible —</option>}
              {optsMarches.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </div>
        <div className="fr-col-12 fr-col-md-6">
          {selectedMarche && (
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="search">Rechercher</label>
              <input id="search" className="fr-input" type="search"
                     placeholder="Nom, prénom, e-mail, spécialité, mot-clé…"
                     value={search} onChange={(e)=>setSearch(e.target.value)} />
              <p className="fr-hint-text fr-mt-1w">
                Clause du marché : <strong>{labelFrom(optsClauses, selectedClauseId)}</strong>
              </p>
            </div>
          )}
        </div>
      </div>

      {/* Liste */}
      {!selectedMarche ? (
        <div className="fr-callout"><p className="fr-callout__text">Veuillez choisir un marché.</p></div>
      ) : (
        <>
          <div className="fr-alert fr-alert--info fr-mb-3w">
            <p><strong>{filteredBenefs.length}</strong> bénéficiaire(s) trouvé(s) pour la clause <strong>{labelFrom(optsClauses, selectedClauseId)}</strong>.</p>
          </div>

          {filteredBenefs.length === 0 ? (
            <div className="fr-callout"><p className="fr-callout__text">Aucun résultat pour cette clause et ces critères.</p></div>
          ) : (
            <div className="fr-grid-row fr-grid-row--gutters">
              {filteredBenefs.map((r) => {
                const nomComplet = fullName(r);
                const speEco = r[B.SPECIALITE_ECOLE] || '';
                return (
                  <div key={r.id} className="fr-col-12 fr-col-md-6">
                    <article className="fr-card fr-enlarge-link fr-card--sm fr-card--horizontal" onClick={() => openModal(r)}>
                      <div className="fr-card__body">
                        <h2 className="fr-card__title fr-text--md">
                          <a href="#" onClick={(e) => { e.preventDefault(); openModal(r); }}>{nomComplet}</a>
                        </h2>
                        {speEco && <p className="fr-card__desc">{speEco}</p>}
                        {/* Pas d'email/tel visibles ici */}
                      </div>
                    </article>
                  </div>
                );
              })}
            </div>
          )}
        </>
      )}

      {/* Modale fiche (coordonnées masquées) */}
      {modalOpen && modalRow && (
        <div role="dialog" aria-modal="true" aria-labelledby="benef-modal-title"
             className="fr-overlay"
             style={{ position:'fixed', inset:0, background:'rgba(0,0,0,.45)', zIndex:9999, display:'flex', alignItems:'center', justifyContent:'center', padding:'1rem', overflow:'auto' }}
             onClick={() => { setModalOpen(false); setModalRow(null); }}
        >
          <div className="fr-container fr-container--fluid fr-container-md"
               style={{maxWidth:'880px', width:'100%'}}
               onClick={(e)=>e.stopPropagation()}>
            <div className="fr-card fr-p-3w" style={{background:'var(--background-default-grey,#fff)', maxHeight:'90vh', overflowY:'auto'}}>
              <div className="fr-grid-row fr-grid-row--middle fr-mb-2w">
                <div className="fr-col">
                  <h2 id="benef-modal-title" className="fr-h4 fr-mb-0">{fullName(modalRow)}</h2>
                  <p className="fr-text--xs fr-text-mention--grey">Clause : <strong>{labelFrom(optsClauses, selectedClauseId)}</strong></p>
                </div>
                <div className="fr-col-auto">
                  <button className="fr-btn fr-btn--tertiary-no-outline" onClick={()=>{ setModalOpen(false); setModalRow(null); }}>Fermer</button>
                </div>
              </div>

              <div className="fr-grid-row fr-grid-row--gutters">
                <div className="fr-col-12 fr-col-lg-7">
                  <dl className="fr-description-list fr-mb-2w">
                    <dt><strong>Formation</strong></dt><dd>{modalRow['gristHelper_Display2'] || '—'}</dd>
                    <dt className="fr-mt-2w"><strong>Année de diplôme</strong></dt><dd>{modalRow[B.ANNEE_DIP] || '—'}</dd>
                    <dt className="fr-mt-2w"><strong>Spécialité</strong></dt><dd>{asArray(modalRow["gristHelper_Display3"]).filter((x)=>x!=='L').join(', ') || '—'}</dd>
                    <dt className="fr-mt-2w"><strong>Sous-spécialité</strong></dt><dd>{modalRow[B.SOUS_SPEC] || '—'}</dd>
                    <dt className="fr-mt-2w"><strong>Mémoire</strong></dt><dd>{modalRow[B.MEMOIRE] || '—'}</dd>
                    <dt className="fr-mt-2w"><strong>CV</strong></dt>
                    {modalRow.cv_url ? (
                        <dd><a href={modalRow.cv_url} target="_blank">Voir le fichier</a></dd>
                    ) : (
                        <dd>Aucun fichier.</dd>
                    )}
                    
                  </dl>
                </div>
                <div className="fr-col-12 fr-col-lg-5">
                  <div className="fr-card fr-p-2w fr-background-alt--blue-france">
                    <h3 className="fr-h6 fr-mb-1w">Localisations</h3>
                    <p className="fr-text--sm fr-mb-1w"><strong>Départements</strong></p>
                    <p className="fr-text--sm">
                      {asArray(modalRow["gristHelper_Display4"]).filter((x)=>x!=='L').join(', ') || '—'}
                    </p>
                    <p className="fr-text--sm fr-mt-2w"><strong>Régions de mobilité</strong></p>
                    <p className="fr-text--sm">
                      {asArray(modalRow["gristHelper_Display5"]).filter((x)=>x!=='L').join(', ') || '—'}
                    </p>
                  </div>
                </div>
              </div>


              {/* Coordonnées masquées / bouton pour révéler et logguer */}
              <div className="fr-callout fr-mb-2w fr-mt-2w">
                {revealedFor.has(modalRow.id) ? (
                  <>
                    <p><strong>Email :</strong> {modalRow[B.EMAIL] || '—'}</p>
                    <p><strong>Téléphone :</strong> {modalRow[B.TEL] || '—'}</p>
                  </>
                ) : (
                  <>
                    <p className="fr-text--sm">Les coordonnées sont masquées.</p>
                    <button className="fr-btn" onClick={() => revealContacts(modalRow.id)}>
                      Afficher les coordonnées
                    </button>
                  </>
                )}
              </div>
            </div>
          </div>
        </div>
      )}
    </section>
  );
};
