const Component = () => {
  const { useState, useEffect, useRef } = React;
  // === Constantes ===
  const N8N_CV_UPLOAD_URL = 'https://n8n.incubateur.anct.gouv.fr/webhook/eclauses/beneficiaires/cv'; // ← à adapter
  const MAX_CV_BYTES = 5 * 1024 * 1024; // 5 Mo
  const ACCEPTED_CV_TYPES = ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
  const TABLE = 'Beneficiaires'; // table principale
  const COL_CV = 'curriculum_vitae';           // ⚠️ colonne pièce jointe cible

  // Tables référentielles
  const REF = {
    formation: 'T0_Referentiel_Formations',
    specialites: 'T0_Referentiel_Specialites',
    departements: 'T0_Referentiel_Departements',
    regions: 'T0_Referentiel_Regions'
  };

  // === Utils ===
  function toBool(v) {
    if (v === true || v === 1 || v === '1') return true;
    if (typeof v === 'string' && v.toLowerCase() === 'true') return true;
    return false;
  }
  function isEmpty(v) {
    return v === null || v === undefined || (typeof v === 'string' && v.trim() === '');
  }
  function asArray(v) {
    return Array.isArray(v) ? v : (v == null ? [] : [v]);
  }
  function cleanListIds(list) {
    const nums = asArray(list)
      .filter(x => x !== 'L')
      .map(v => typeof v === 'number' ? v : Number(v))
      .filter(v => Number.isFinite(v));
    return Array.from(new Set(nums)); // déduplication
  }
  const displayList = (values) => cleanListIds(values);
  function emailLooksOk(v) {
    if (isEmpty(v)) return true;
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }
  function uniqSorted(arr) {
    return Array.from(new Set(arr.filter(Boolean))).sort();
  }
  function pickLabelField(rows) {
    if (!rows || !rows.length) return 'id';
    const sample = rows[0];
    const keys = Object.keys(sample || {});
    const preferred = ['label', 'name', 'Nom', 'nom', 'title', 'Title', 'libelle', 'Libelle'];
    for (const k of preferred) if (k in sample && typeof sample[k] === 'string') return k;
    for (const k of keys) if (typeof sample[k] === 'string') return k;
    return 'id';
  }

  function toOptions(rows, key = undefined) {
    const k = key === undefined ? pickLabelField(rows) : key;
    return (rows || []).map(r => ({ value: r.id, label: String(r[k] ?? r.id) }));
  }

  // === États ===
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState(null);
  const [rows, setRows] = useState([]);
  const [currentId, setCurrentId] = useState(null);
  const [saving, setSaving] = useState(false);
  const [msg, setMsg] = useState(null);

  // Auth (depuis MagicLink)
  const [auth, setAuth] = useState(null);

  // Référentiels
  const [optFormation, setOptFormation] = useState([]);
  const [optSpecialites, setOptSpecialites] = useState([]);
  const [optDepartements, setOptDepartements] = useState([]);
  const [optRegions, setOptRegions] = useState([]);
  const specsCombo = useCombobox([]);
  const regionsCombo = useCombobox([]);

  // Choice suggestions
  const [yearsOptions, setYearsOptions] = useState([]);
  const [otherFormation, setOtherFormation] = useState('');

  // Fichier CV en attente d’upload
  const [fileCV, setFileCV] = useState(null);
  const [uploading, setUploading] = useState(false);

  // Formulaire (état éditable)
  const [form, setForm] = useState({
    'NOM': '',
    'Prenom': '',
    'Courriel': '',
    'Telephone': '',
    'Sous_specialite': '',
    'Intitule_du_memoire': '',
    'Autres_informations': '',
    'Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur': false,
    'Je_consens_a_etre_contacte_pour_rejoindre_des_groupements': false,
    'Annee_de_diplome': '',
    'Formation': null,
    'Specialite': [],
    'Departement_de_residence': [],
    'Regions_ou_vous_etes_mobile': [],
    [COL_CV]: []
  });

  // === Chargement initial via AUTH (MagicLink) ===
  useEffect(() => {
    let mounted = true;

    async function loadAll() {
      try {
        setLoading(true);
        setErr(null);

        // 0) Auth via MagicLink (si exposé par le widget)
        let authInfo = gristAPI.getAuth ? gristAPI.getAuth() : null;
        if (!mounted) return;
        setAuth(authInfo);
        console.log(authInfo);

        // 1) Données principales
        const data = await gristAPI.getData(TABLE);

        // 2) Référentiels (si interdits par ACL, on retombe sur des listes vides)
        const [formations, specs, deps, regs] = await Promise.all([
          gristAPI.getData(REF.formation).catch(() => []),
          gristAPI.getData(REF.specialites).catch(() => []),
          gristAPI.getData(REF.departements).catch(() => []),
          gristAPI.getData(REF.regions).catch(() => []),
        ]);

        if (!mounted) return;

        setRows(data || []);
        setOptFormation(sortByLabelFr(toOptions(formations,'Intitule')));
        setOptSpecialites(sortByLabelFr(toOptions(specs, 'Intitule')));
        setOptDepartements((deps || []).map(r => ({ value: r.id, label: String(r['Departement_Numero'])+" - "+String(r['Departement_Nom']) })));
        setOptRegions(toOptions(regs,'Intitule'));

        // Suggestions pour Choice "Annee_de_diplome"
        const yearValues = uniqSorted((data || []).map(r => r['Annee_de_diplome']).filter(Boolean).map(String));
        setYearsOptions(yearValues);

        // 3) Déterminer l'ID courant depuis l'auth
        let id = authInfo && authInfo.beneficiaireId ? authInfo.beneficiaireId : null;

        // Fallback : si ACL limite la table à une seule ligne visible
        if (!id && Array.isArray(data) && data.length === 1) {
          id = data[0].id;
        }

        setCurrentId(id || null);

        if (id) {
          const rec = (data || []).find(r => r.id === id) || null;
          if (rec) seedForm(rec);
          else setErr("Votre fiche n'est pas accessible avec ce lien.");
        }
      } catch (e) {
        if (!mounted) return;
        setErr(e.message || 'Erreur de chargement');
      } finally {
        if (mounted) setLoading(false);
      }
    }

    loadAll();

    return () => { mounted = false; };
  }, []);

  // === Seed form depuis un record ===
  function seedForm(rec) {
    setForm({
      'NOM': rec['NOM'] || '',
      'Prenom': rec['Prenom'] || '',
      'Courriel': rec['Courriel'] || '',
      'Telephone': rec['Telephone'] || '',
      'Specialite_ecole': rec['Specialite_ecole'] || '',
      'Sous_specialite': rec['Sous_specialite'] || '',
      'Intitule_du_memoire': rec['Intitule_du_memoire'] || '',
      'Autres_informations': rec['Autres_informations'] || '',
      'Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur': toBool(rec['Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur']),
      'Je_consens_a_etre_contacte_pour_rejoindre_des_groupements': toBool(rec['Je_consens_a_etre_contacte_pour_rejoindre_des_groupements']),
      'Annee_de_diplome': rec['Annee_de_diplome'] || '',
      'Formation': rec['Formation'] ?? null,
      'Specialite': asArray(rec['Specialite']),
      'Departement_de_residence': asArray(rec['Departement_de_residence']),
      'Regions_ou_vous_etes_mobile': asArray(rec['Regions_ou_vous_etes_mobile']),
      [COL_CV]: asArray(rec[COL_CV])
    });
    setFileCV(null);
  }

  // === Handlers ===
  function setField(name, value) { setForm(prev => ({ ...prev, [name]: value })); }
  function setSelectSingle(name, e) {
    const v = e.target.value;
    setField(name, v ? Number(v) : null);
  }
  function setSelectMulti(name, e) {
    const values = Array.from(e.target.selectedOptions).map(o => Number(o.value)).filter(v => Number.isFinite(v));
    setField(name, cleanListIds(values));
  }

  // Combobox multi (options, sélection, recherche)
  function useCombobox(initialSelection = []) {
    const [open, setOpen] = useState(false);
    const [search, setSearch] = useState('');
    const [pos, setPos] = useState({ top: 0, left: 0, width: 0 });
    const boxRef = useRef(null);

    useEffect(() => {
      if (!open) return;
      const onClick = (e) => {
        if (boxRef.current && !boxRef.current.contains(e.target)) setOpen(false);
      };
      const onScroll = () => setOpen(false);
      const onResize = () => setOpen(false);
      document.addEventListener('click', onClick);
      window.addEventListener('scroll', onScroll, true);
      window.addEventListener('resize', onResize);
      return () => {
        document.removeEventListener('click', onClick);
        window.removeEventListener('scroll', onScroll, true);
        window.removeEventListener('resize', onResize);
      };
    }, [open]);

    function toggle() {
      const rect = boxRef.current?.getBoundingClientRect();
      if (rect) setPos({ top: rect.bottom + 4, left: rect.left, width: rect.width });
      setOpen(o => !o);
    }

    return { open, setOpen, search, setSearch, pos, boxRef, toggle };
  }

  async function save() {
    if (!currentId) return;
    setErr(null); setMsg(null);

    if (!emailLooksOk(form['Courriel'])) {
      setErr('Adresse e-mail invalide.');
      return;
    }

    const formationAutre = optFormation.find(o => o.label === 'Autre (à préciser)');
    const isAutre = formationAutre && form['Formation'] === formationAutre.value;
    const autreTexte = otherFormation && otherFormation.trim() ? otherFormation.trim() : null;

    const updates = {
      'NOM': form['NOM'],
      'Prenom': form['Prenom'],
      'Courriel': form['Courriel'],
      'Telephone': form['Telephone'],
      'Specialite_ecole': form['Specialite_ecole'],
      'Autre_Formation': isAutre ? (autreTexte || '') : '',
      'Sous_specialite': form['Sous_specialite'],
      'Intitule_du_memoire': form['Intitule_du_memoire'],
      'Autres_informations': form['Autres_informations'],
      'Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur': !!form['Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur'],
      'Je_consens_a_etre_contacte_pour_rejoindre_des_groupements': !!form['Je_consens_a_etre_contacte_pour_rejoindre_des_groupements'],
      'Annee_de_diplome': form['Annee_de_diplome'] || null,
      'Formation': form['Formation'] ?? null,
      'Specialite': form['Specialite'] || [],
      'Departement_de_residence': form['Departement_de_residence'] || [],
      'Regions_ou_vous_etes_mobile': form['Regions_ou_vous_etes_mobile'] || [],
      [COL_CV]: form[COL_CV] || []
    };

    console.log(updates);

    try {
      setSaving(true);
      await gristAPI.updateRecord(TABLE, currentId, updates);
      setMsg('Profil enregistré avec succès.');
    } catch (e) {
      setErr(e.message || 'Erreur lors de l’enregistrement.');
    } finally {
      setSaving(false);
    }
  }

  // === Upload CV via n8n ===
  async function uploadCV() {
    if (!currentId || !fileCV) return;
    setErr(null); setMsg(null);
    try {
      if (fileCV.size > MAX_CV_BYTES) {
        throw new Error('Fichier trop volumineux (max 5 Mo).');
      }
      if (ACCEPTED_CV_TYPES.length && !ACCEPTED_CV_TYPES.includes(fileCV.type)) {
        throw new Error('Type de fichier non autorisé (PDF ou DOC/DOCX attendus).');
      }

      setUploading(true);

      const formData = new FormData();
      formData.append('file', fileCV);               // le fichier
      formData.append('benef_id', String(currentId)); // pour que n8n sache quelle ligne mettre à jour

      const res = await fetch(N8N_CV_UPLOAD_URL, {
        method: 'POST',
        body: formData,
      });

      // Attendu: { ok: true, message?: string }
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) {
        throw new Error(data.message || 'Échec du téléversement via n8n.');
      }

      // Rafraîchit la fiche (n8n a déjà mis à jour la colonne côté Grist)
      await refreshRow();
      setFileCV(null);
      setMsg('CV téléversé et attaché au profil.');
    } catch (e) {
      setErr(e.message || 'Échec du téléversement du CV.');
    } finally {
      setUploading(false);
    }
  }

function sortByLabelFr(options) {
  return [...(options || [])].sort((a, b) =>
    String(a.label).localeCompare(String(b.label), 'fr', {
      sensitivity: 'base',
      ignorePunctuation: true,
    })
  );
}

  async function clearCV() {
    if (!currentId) return;
    setErr(null); setMsg(null);
    try {
      await gristAPI.updateRecord(TABLE, currentId, { [COL_CV]: [] });
      setField(COL_CV, []);
      setMsg('CV supprimé de la fiche.');
    } catch (e) {
      setErr(e.message || 'Impossible de supprimer le CV.');
    }
  }

  // === Rendu ===
  if (loading) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-loader" aria-label="Chargement" />
        <p className="fr-text--sm fr-mt-1w">Chargement du profil…</p>
      </section>
    );
  }

  if (err) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--error"><p><strong>Erreur :</strong> {err}</p></div>
      </section>
    );
  }

  if (!currentId) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--warning">
          <p>
            Impossible d’identifier votre fiche à partir de ce lien.
            {auth ? ' ' : ' '}Vérifiez que votre lien magique est valide et non expiré.
          </p>
        </div>
      </section>
    );
  }

  const cvCount = (form[COL_CV] || []).length;

  return (
    <section className="fr-container fr-my-6w">
      <header className="fr-mb-4w">
        <h1 className="fr-h3 fr-mb-1w">Mon profil</h1>
      </header>

      {msg && <div className="fr-alert fr-alert--success fr-mb-3w"><p>{msg}</p></div>}
      {err && <div className="fr-alert fr-alert--error fr-mb-3w"><p>{err}</p></div>}

      <div className="fr-card fr-p-3w fr-mb-3w">
        <div className="fr-grid-row fr-grid-row--gutters">
          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="nom">Nom</label>
              <input id="nom" className="fr-input" type="text"
                value={form['NOM']} onChange={(e) => setField('NOM', e.target.value)} />
            </div>
          </div>
          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="prenom">Prénom</label>
              <input id="prenom" className="fr-input" type="text"
                value={form['Prenom']} onChange={(e) => setField('Prenom', e.target.value)} />
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="courriel">Courriel</label>
              <input id="courriel" className="fr-input" type="email"
                value={form['Courriel']} onChange={(e) => setField('Courriel', e.target.value)} />
              {!emailLooksOk(form['Courriel']) && <p className="fr-error-text">Format d’e-mail invalide.</p>}
            </div>
          </div>
          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="tel">Téléphone</label>
              <input id="tel" className="fr-input" type="text"
                value={form['Telephone']} onChange={(e) => setField('Telephone', e.target.value)} />
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="annee">Année de diplôme</label>
              <select id="annee" className="fr-select"
                value={String(form['Annee_de_diplome'] || '')}
                onChange={(e) => setField('Annee_de_diplome', e.target.value || '')}>
                <option value="">—</option>
                {yearsOptions.map(y => <option key={y} value={y}>{y}</option>)}
              </select>
              <p className="fr-hint-text">La liste est proposée à partir des valeurs existantes ; vous pouvez laisser vide.</p>
            </div>
          </div>
          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-select-group">
              <label className="fr-label" htmlFor="formation">Formation</label>
              <select id="formation" className="fr-select"
                value={form['Formation'] ?? ''}
                onChange={(e) => setSelectSingle('Formation', e)}>
                <option value="">—</option>
                {optFormation.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              {optFormation.some(o => o.label === 'Autre (à préciser)') && form['Formation'] === optFormation.find(o => o.label === 'Autre (à préciser)')?.value && (
                <div className="fr-input-group fr-mt-2w">
                  <label className="fr-label" htmlFor="formation-autre">Préciser la formation</label>
                  <input
                    id="formation-autre"
                    className="fr-input"
                    type="text"
                    value={otherFormation}
                    onChange={(e) => setOtherFormation(e.target.value)}
                    placeholder="Votre formation"
                  />
                  <p className="fr-hint-text">Ce texte sera enregistré dans le champ “Specialite_ecole”.</p>
                </div>
              )}
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div
              className="fr-input-group"
              ref={specsCombo.boxRef}
              style={{ position: 'relative' }}
              onClick={(e) => e.stopPropagation()}
              onMouseDown={(e) => e.stopPropagation()}
            >
              <label className="fr-label" htmlFor="specs-combo">Spécialité(s)</label>
              <div className="fr-input-wrap" style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                {displayList(form['Specialite']).map(id => (
                  <span key={id} className="fr-tag fr-tag--sm" style={{ marginBottom: '0.25rem' }}>
                    {optSpecialites.find(o => o.value === id)?.label || id}
                    <button
                      type="button"
                      className="fr-tag__dismiss"
                      aria-label="Retirer"
                      onClick={(e) => {
                        e.stopPropagation();
                        const next = displayList(form['Specialite']).filter(x => x !== id);
                        setField('Specialite', ['L', ...next]);
                      }}
                    >
                      ×
                    </button>
                  </span>
                ))}
                <button
                  type="button"
                  className="fr-input"
                  id="specs-combo"
                  aria-expanded={specsCombo.open}
                  onClick={(e) => { e.stopPropagation(); specsCombo.toggle(); }}
                  style={{ flex: '1 1 240px', textAlign: 'left' }}
                >
                  {displayList(form['Specialite']).length ? 'Ajouter / modifier la sélection' : 'Choisir des spécialités'}
                </button>
              </div>
              {specsCombo.open && (
                <div
                  className="fr-card"
                  style={{
                    position: 'fixed',
                    zIndex: 9999,
                    background: 'var(--background-raised-grey, #fff)',
                    border: '1px solid var(--border-default-grey)',
                    borderRadius: '0.5rem',
                    width: specsCombo.pos.width || '320px',
                    top: specsCombo.pos.top || 0,
                    left: specsCombo.pos.left || 0,
                    maxHeight: '320px',
                    overflow: 'hidden',
                    boxShadow: '0 8px 18px rgba(0,0,0,0.15)',
                    pointerEvents: 'auto'
                  }}
                  onClick={(e) => e.stopPropagation()}
                  onMouseDown={(e) => e.stopPropagation()}
                >
                  <div style={{ padding: '0.75rem', borderBottom: '1px solid var(--border-default-grey)' }}>
                    <input
                      className="fr-input"
                      type="search"
                      placeholder="Rechercher une spécialité"
                      value={specsCombo.search}
                      onChange={(e) => specsCombo.setSearch(e.target.value)}
                    />
                  </div>
                  <div style={{ maxHeight: '240px', overflowY: 'auto' }}>
                    {optSpecialites
                      .filter(o => !specsCombo.search || String(o.label).toLowerCase().includes(String(specsCombo.search).toLowerCase()))
                      .map(o => {
                        const checked = displayList(form['Specialite']).includes(o.value);
                        return (
                          <label key={o.value} className="fr-checkbox-group fr-px-1w fr-py-0_5w" style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                            <input
                              type="checkbox"
                              checked={checked}
                              onChange={() => {
                                const id = Number(o.value);
                                const base = displayList(form['Specialite']);
                                const next = checked
                                  ? base.filter(x => x !== id)
                                  : [...base, id];
                                setField('Specialite', ['L', ...next]);
                              }}
                            />
                            <span>{o.label}</span>
                          </label>
                        );
                      })}
                    {!optSpecialites.length && (
                      <p className="fr-text--sm fr-pt-1w fr-px-1w">Aucune spécialité disponible.</p>
                    )}
                  </div>
                  <div className="fr-px-1w fr-py-1w" style={{ borderTop: '1px solid var(--border-default-grey)', display: 'flex', gap: '0.5rem', justifyContent: 'flex-end' }}>
                    <button type="button" className="fr-btn fr-btn--secondary" onClick={() => setField('Specialite', [])}>Effacer</button>
                    <button type="button" className="fr-btn" onClick={() => specsCombo.setOpen(false)}>Fermer</button>
                  </div>
                </div>
              )}
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="sous-spec">Sous-spécialité</label>
              <input id="sous-spec" className="fr-input" type="text"
                value={form['Sous_specialite']} onChange={(e) => setField('Sous_specialite', e.target.value)} />
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div className="fr-select-group">
              <label className="fr-label" htmlFor="deps">Département(s) de résidence</label>
              <select id="deps" multiple className="fr-select"
                value={(form['Departement_de_residence'] || []).map(String)}
                onChange={(e) => setSelectMulti('Departement_de_residence', e)}>
                {optDepartements.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
            </div>
          </div>

          <div className="fr-col-12 fr-col-md-6 fr-mb-3w">
            <div
              className="fr-input-group"
              ref={regionsCombo.boxRef}
              style={{ position: 'relative' }}
              onClick={(e) => e.stopPropagation()}
              onMouseDown={(e) => e.stopPropagation()}
            >
              <label className="fr-label" htmlFor="regions">Régions de mobilité</label>
              <div className="fr-input-wrap" style={{ display: 'flex', gap: '0.5rem', flexWrap: 'wrap' }}>
                {displayList(form['Regions_ou_vous_etes_mobile']).map(id => (
                  <span key={id} className="fr-tag fr-tag--sm" style={{ marginBottom: '0.25rem' }}>
                    {optRegions.find(o => o.value === id)?.label || id}
                    <button
                      type="button"
                      className="fr-tag__dismiss"
                      aria-label="Retirer"
                      onClick={(e) => {
                        e.stopPropagation();
                        const next = displayList(form['Regions_ou_vous_etes_mobile']).filter(x => x !== id);
                        setField('Regions_ou_vous_etes_mobile', ['L', ...next]);
                      }}
                    >
                      ×
                    </button>
                  </span>
                ))}
                <button
                  type="button"
                  className="fr-input"
                  id="regions"
                  aria-expanded={regionsCombo.open}
                  onClick={(e) => { e.stopPropagation(); regionsCombo.toggle(); }}
                  style={{ flex: '1 1 240px', textAlign: 'left' }}
                >
                  {displayList(form['Regions_ou_vous_etes_mobile']).length ? 'Ajouter / modifier la sélection' : 'Choisir des régions'}
                </button>
              </div>
              {regionsCombo.open && (
                <div
                  className="fr-card"
                  style={{
                    position: 'fixed',
                    zIndex: 9999,
                    background: 'var(--background-raised-grey, #fff)',
                    border: '1px solid var(--border-default-grey)',
                    borderRadius: '0.5rem',
                    width: regionsCombo.pos.width || '320px',
                    top: regionsCombo.pos.top || 0,
                    left: regionsCombo.pos.left || 0,
                    maxHeight: '320px',
                    overflow: 'hidden',
                    boxShadow: '0 8px 18px rgba(0,0,0,0.15)',
                    pointerEvents: 'auto'
                  }}
                  onClick={(e) => e.stopPropagation()}
                  onMouseDown={(e) => e.stopPropagation()}
                >
                  <div style={{ padding: '0.75rem', borderBottom: '1px solid var(--border-default-grey)' }}>
                    <input
                      className="fr-input"
                      type="search"
                      placeholder="Rechercher une région"
                      value={regionsCombo.search}
                      onChange={(e) => regionsCombo.setSearch(e.target.value)}
                    />
                  </div>
                  <div style={{ maxHeight: '240px', overflowY: 'auto' }}>
                    {optRegions
                      .filter(o => !regionsCombo.search || String(o.label).toLowerCase().includes(String(regionsCombo.search).toLowerCase()))
                      .map(o => {
                        const checked = displayList(form['Regions_ou_vous_etes_mobile']).includes(o.value);
                        return (
                          <label key={o.value} className="fr-checkbox-group fr-px-1w fr-py-0_5w" style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                            <input
                              type="checkbox"
                              checked={checked}
                              onChange={() => {
                                const id = Number(o.value);
                                const base = displayList(form['Regions_ou_vous_etes_mobile']);
                                const next = checked
                                  ? base.filter(x => x !== id)
                                  : [...base, id];
                                setField('Regions_ou_vous_etes_mobile', ['L', ...next]);
                              }}
                            />
                            <span>{o.label}</span>
                          </label>
                        );
                      })}
                    {!optRegions.length && (
                      <p className="fr-text--sm fr-pt-1w fr-px-1w">Aucune région disponible.</p>
                    )}
                  </div>
                  <div className="fr-px-1w fr-py-1w" style={{ borderTop: '1px solid var(--border-default-grey)', display: 'flex', gap: '0.5rem', justifyContent: 'flex-end' }}>
                    <button type="button" className="fr-btn fr-btn--secondary" onClick={() => setField('Regions_ou_vous_etes_mobile', [])}>Effacer</button>
                    <button type="button" className="fr-btn" onClick={() => regionsCombo.setOpen(false)}>Fermer</button>
                  </div>
                </div>
              )}
            </div>
          </div>

          <div className="fr-col-12 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="memoire">Intitulé du mémoire</label>
              <input id="memoire" className="fr-input" type="text"
                value={form['Intitule_du_memoire']} onChange={(e) => setField('Intitule_du_memoire', e.target.value)} />
            </div>
          </div>

          <div className="fr-col-12 fr-mb-3w">
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="infos">Autres informations</label>
              <textarea id="infos" placeholder="Diplômes et formations complétementaires, lien vers CV en ligne, etc." className="fr-input" rows="4"
                value={form['Autres_informations']} onChange={(e) => setField('Autres_informations', e.target.value)} />
            </div>
          </div>
        </div>
      </div>

      <div className="fr-card fr-p-3w fr-mb-3w">
        <h2 className="fr-h6 fr-mb-2w">Curriculum Vitae</h2>
        <p className="fr-mb-1w">Fichier actuel : <strong>{cvCount ? `${cvCount} fichier(s)` : 'Aucun'}</strong></p>
        <div className="fr-upload-group fr-my-2w">
          <label className="fr-label" htmlFor="cvfile">Sélectionner un fichier</label>
          <input id="cvfile" className="fr-upload" type="file"
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            onChange={(e) => setFileCV(e.target.files && e.target.files[0] ? e.target.files[0] : null)} />
          {fileCV && <p className="fr-hint-text">Prêt à téléverser : {fileCV.name}</p>}
          <p className="fr-hint-text">Formats acceptés : PDF, DOC, DOCX. Taille max : 5 Mo.</p>
        </div>
        <div className="fr-btns-group fr-btns-group--inline fr-btns-group--sm">
          <button className="fr-btn" onClick={uploadCV} disabled={!fileCV || uploading}>
            {uploading ? 'Téléversement…' : 'Téléverser'}
          </button>
          <button className="fr-btn fr-btn--secondary" onClick={clearCV} disabled={uploading || (!form[COL_CV] || !form[COL_CV].length)}>
            Supprimer le CV
          </button>
        </div>
      </div>

      <div className="fr-card fr-p-3w fr-mb-4w">
        <fieldset className="fr-fieldset" aria-labelledby="consents-legend">
          <legend className="fr-fieldset__legend" id="consents-legend">Consentements</legend>
          <p className="fr-text--sm fr-mb-2w">En cochant les cases ci-dessous, je consens à :</p>
          <div className="fr-checkbox-group fr-checkbox-group--sm fr-col-12">
            <input type="checkbox" id="consent-annuaire"
              checked={!!form['Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur']}
              onChange={(e) => setField('Je_consens_a_figurer_dans_l_annuaire_partage_avec_les_professionnels_du_secteur', e.target.checked)} />
            <label className="fr-label" htmlFor="consent-annuaire">Figurer dans l’annuaire partagé</label>
          </div>
          <div className="fr-checkbox-group fr-checkbox-group--sm fr-col-12">
            <input type="checkbox" id="consent-groupements"
              checked={!!form['Je_consens_a_etre_contacte_pour_rejoindre_des_groupements']}
              onChange={(e) => setField('Je_consens_a_etre_contacte_pour_rejoindre_des_groupements', e.target.checked)} />
            <label className="fr-label" htmlFor="consent-groupements">Être contacté pour rejoindre des groupements</label>
          </div>
        </fieldset>
      </div>

      <div className="fr-btns-group fr-btns-group--right fr-mt-3w">
        <button className="fr-btn" onClick={save} disabled={saving}>
          {saving ? 'Enregistrement…' : 'Enregistrer mes informations'}
        </button>
      </div>
    </section>
  );
};
