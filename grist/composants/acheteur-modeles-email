const Component = () => {
  // --- Auth & helpers ---
  const auth = gristAPI.getAuth ? gristAPI.getAuth() : null;
  const H = (typeof helpers !== 'undefined') ? helpers : {};
  const formatDateFr = H.formatDateFr || (d => d ? new Date(d).toLocaleDateString('fr-FR') : '—');
  const toOptions = H.toOptions || (rows=>{
    if (!Array.isArray(rows)) return [];
    const sample = rows[0] || {};
    const pref = ['label','name','Nom','nom','title','Title','Libellé','Libelle','libelle'];
    let labelKey = 'id';
    for (const k of pref) if (typeof sample[k] === 'string') { labelKey = k; break; }
    if (labelKey === 'id') for (const k of Object.keys(sample)) if (typeof sample[k] === 'string') { labelKey = k; break; }
    return rows.map(r => ({ value: r.id, label: String(r[labelKey] ?? r.id) }));
  });
  const labelFrom = (opts, id) => (opts.find(o=>o.value===id)?.label ?? String(id ?? '—'));
  const emailLooksOk = H.emailLooksOk || ((v)=>!v || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v));

  // --- Restriction d’accès ---
  const isBuyer = !!(auth && (auth.role === 'acheteur' || auth.acheteurId));
  if (!isBuyer) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--warning">
          <p>Accès réservé aux <strong>acheteurs</strong>. Merci de vous connecter avec un compte acheteur.</p>
        </div>
      </section>
    );
  }

  // --- Tables & colonnes ---
  const TABLE = { M:'Marches', C:'Clauses_sociales', A:'Acheteurs', TPL:'Modeles_Emails' }; // TPL optionnel
  const COL = {
    M_INTITULE:'Intitule',
    M_INTITULE_PROPRE:'Intitule_propre',
    M_AA:'Autorite_adjudicatrice',
    M_CLAUSE:'Clauses_sociales',
    M_ADR:'Adresse_de_realisation',
    M_PUB:'Date_de_publication',
    M_DL_CANDID:'Date_limite_de_candidature',
    M_DL_REAL:'Date_Limite_de_Realisation_de_l_Operation',
    M_DOCS:'Lien_vers_les_documents_d_appel_d_offres' // si existe (formule dans votre doc)
  };

  // --- Modèles intégrés (fallback) ---
  const builtInTemplates = [
    {
      code: 'places_intitule',
      titre: 'Intitulé de la consultation PLACES',
      sujet: 'Consultation PLACES – {{marche_intitule}}',
      corps:
`Madame, Monsieur,

L’autorité adjudicatrice {{acheteur_nom}} lance une consultation sur la plateforme PLACES :
Objet : {{marche_intitule}}
Clause sociale : {{clause_label}}
Adresse de réalisation : {{marche_adresse}}
Publication : {{date_publication}}
Date limite de candidature : {{date_limite_candidature}}
Date limite de réalisation : {{date_limite_realisation}}
{{#lien_dce}}Documents de consultation : {{lien_dce}}{{/lien_dce}}

Nous vous invitons à en prendre connaissance et à candidater si vous êtes intéressé·e.

Cordialement,
{{acheteur_nom}}
{{acheteur_email}}`
    },
    {
      code: 'infos_clauses',
      titre: 'Informations sur les clauses',
      sujet: 'Informations complémentaires – Clauses sociales ({{clause_label}})',
      corps:
`Bonjour,

Dans le cadre de nos marchés intégrant des clauses sociales ({{clause_label}}), voici quelques précisions :
• Public visé / attendus : {{clause_label}}
• Contexte : {{marche_intitule}}
• Adresse de réalisation : {{marche_adresse}}
• Échéances : candidature {{date_limite_candidature}} – réalisation {{date_limite_realisation}}

Pour toute question ou besoin d’accompagnement, vous pouvez répondre à ce message.

Bien cordialement,
{{acheteur_nom}}
{{acheteur_email}}`
    }
  ];

  // --- State ---
  const [loading, setLoading] = React.useState(true);
  const [err, setErr] = React.useState(null);

  const [marches, setMarches] = React.useState([]);
  const [clauses, setClauses] = React.useState([]);
  const [acheteurs, setAcheteurs] = React.useState([]);

  const [optsClauses, setOptsClauses] = React.useState([]);
  const [myMarkets, setMyMarkets] = React.useState([]);

  const [templates, setTemplates] = React.useState(builtInTemplates);
  const [selectedTpl, setSelectedTpl] = React.useState(builtInTemplates[0]?.code || '');

  const [selectedMarketId, setSelectedMarketId] = React.useState('');
  const [to, setTo] = React.useState('');
  const [cc, setCc] = React.useState('');

  // Aperçu
  const [subject, setSubject] = React.useState('');
  const [body, setBody] = React.useState('');

  // --- Load ---
  React.useEffect(() => {
    let mounted = true;
    (async () => {
      try {
        setLoading(true); setErr(null);

        const [m, c, a, tpls] = await Promise.all([
          gristAPI.getData(TABLE.M),
          gristAPI.getData(TABLE.C).catch(()=>[]),
          gristAPI.getData(TABLE.A).catch(()=>[]),
          gristAPI.getData(TABLE.TPL).catch(()=>[]) // optionnel
        ]);

        if (!mounted) return;

        setMarches(Array.isArray(m)?m:[]);
        setClauses(Array.isArray(c)?c:[]);
        setAcheteurs(Array.isArray(a)?a:[]);
        setOptsClauses(toOptions(Array.isArray(c)?c:[]));

        // mes marchés
        const mine = (Array.isArray(m)?m:[]).filter(r => r && r[COL.M_AA] === (auth?.acheteurId ?? null));
        setMyMarkets(mine);

        // templates BD optionnels : colonnes Code;Titre;Sujet;Corps (séparateur ';' OK)
        if (Array.isArray(tpls) && tpls.length) {
          const cooked = tpls
            .map(r => ({
              code: r.Code || r.code || r.CODE || `tpl_${r.id}`,
              titre: r.Titre || r.titre || r.TITRE || `Modèle #${r.id}`,
              sujet: r.Sujet || r.sujet || r.SUJET || '',
              corps: r.Corps || r.corps || r.CORPS || ''
            }))
            .filter(t => t.code && (t.sujet || t.corps));
          if (cooked.length) {
            const merged = [
              ...builtInTemplates,
              ...cooked
            ];
            setTemplates(merged);
            setSelectedTpl(merged[0].code);
          }
        }

        // pré-sélection : 1er marché
        if (mine.length) setSelectedMarketId(String(mine[0].id));
      } catch (e) {
        if (mounted) setErr(e.message || 'Erreur de chargement');
      } finally {
        if (mounted) setLoading(false);
      }
    })();
    return () => { mounted = false; };
  }, []);

  // --- Variables & rendu modèle ---
  function cleanClauseLabel(lab) {
    if (!lab) return '';
    if (lab === 'L' || lab === '-') return ''; // nettoyage artefacts
    return lab;
  }

  function renderTemplate(tpl, vars) {
    // Mini moustache {{var}} + section booléenne {{#var}}...{{/var}}
    let s = tpl;
    // sections
    s = s.replace(/{{#(\w+)}}([\s\S]*?){{\/\1}}/g, (_, key, inner) => {
      const v = vars[key];
      return (v && String(v).trim() !== '') ? inner : '';
    });
    // simples
    s = s.replace(/{{(\w+)}}/g, (_, key) => (vars[key] ?? ''));
    return s;
  }

  const currentTpl = templates.find(t => t.code === selectedTpl) || templates[0] || {};
  const currentMarket = myMarkets.find(m => String(m.id) === String(selectedMarketId)) || null;
  const buyerRow = acheteurs.find(a => a.id === (auth?.acheteurId ?? null)) || {};

  const clauseLabel = cleanClauseLabel(
    currentMarket && typeof currentMarket[COL.M_CLAUSE] === 'number'
      ? labelFrom(optsClauses, currentMarket[COL.M_CLAUSE])
      : ''
  );

  const vars = {
    acheteur_nom: buyerRow.Nom || buyerRow.name || buyerRow.label || 'Votre entité',
    acheteur_email: buyerRow.Email || buyerRow.email || (auth?.email || ''),
    marche_intitule: (currentMarket?.[COL.M_INTITULE_PROPRE] || currentMarket?.[COL.M_INTITULE] || '').trim(),
    marche_adresse: currentMarket?.[COL.M_ADR] || '',
    clause_label: clauseLabel,
    date_publication: formatDateFr(currentMarket?.[COL.M_PUB]),
    date_limite_candidature: formatDateFr(currentMarket?.[COL.M_DL_CANDID]),
    date_limite_realisation: formatDateFr(currentMarket?.[COL.M_DL_REAL]),
    lien_dce: currentMarket?.[COL.M_DOCS] || ''
  };

  React.useEffect(() => {
    const s = renderTemplate(currentTpl.sujet || '', vars);
    const b = renderTemplate(currentTpl.corps || '', vars);
    setSubject(s);
    setBody(b);
  }, [selectedTpl, selectedMarketId, JSON.stringify(vars)]);

  // --- Actions ---
  async function copyText(txt) {
    try {
      await navigator.clipboard.writeText(txt || '');
      alert('Copié dans le presse-papier.');
    } catch {
      // fallback
      const ta = document.createElement('textarea');
      ta.value = txt || '';
      document.body.appendChild(ta);
      ta.select(); try { document.execCommand('copy'); } catch(_) {}
      document.body.removeChild(ta);
      alert('Copié dans le presse-papier.');
    }
  }

  function buildMailto() {
    const toParam = (to||'').trim();
    if (toParam && !emailLooksOk(toParam)) {
      alert('Adresse destinataire invalide.');
      return '#';
    }
    const ccParam = (cc||'').trim();
    if (ccParam && !emailLooksOk(ccParam)) {
      alert('Adresse CC invalide.');
      return '#';
    }
    const params = new URLSearchParams();
    if (subject) params.set('subject', subject);
    if (body) params.set('body', body);
    if (ccParam) params.set('cc', ccParam);
    return `mailto:${encodeURIComponent(toParam)}?${params.toString()}`;
  }

  // --- UI ---
  if (loading) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-loader" aria-label="Chargement" />
        <p className="fr-text--sm fr-mt-1w">Chargement des modèles d’e-mail…</p>
      </section>
    );
  }
  if (err) {
    return (
      <section className="fr-container fr-my-6w">
        <div className="fr-alert fr-alert--error"><p><strong>Erreur :</strong> {err}</p></div>
      </section>
    );
  }

  return (
    <section className="fr-container fr-my-6w">
      <header className="fr-mb-4w">
        <h1 className="fr-h3 fr-mb-1w">Modèles d’e-mail</h1>
        <p className="fr-text--sm fr-text-mention--grey">
          Préparez rapidement vos messages (consultation PLACES, informations sur les clauses, etc.).
        </p>
      </header>

      <div className="fr-grid-row fr-grid-row--gutters">
        {/* Colonne gauche : paramètres */}
        <div className="fr-col-12 fr-col-lg-5">
          <div className="fr-card fr-p-3w">
            <h2 className="fr-h6">Choix du modèle</h2>
            <div className="fr-select-group fr-mb-3w">
              <label className="fr-label" htmlFor="tpl">Modèle</label>
              <select id="tpl" className="fr-select" value={selectedTpl} onChange={(e)=>setSelectedTpl(e.target.value)}>
                {templates.map(t => <option key={t.code} value={t.code}>{t.titre}</option>)}
              </select>
            </div>

            <h2 className="fr-h6">Données du marché</h2>
            {myMarkets.length ? (
              <div className="fr-select-group fr-mb-3w">
                <label className="fr-label" htmlFor="marche">Marché</label>
                <select id="marche" className="fr-select" value={selectedMarketId} onChange={(e)=>setSelectedMarketId(e.target.value)}>
                  {myMarkets.map(m => {
                    const label = m[COL.M_INTITULE_PROPRE] || m[COL.M_INTITULE] || `#${m.id}`;
                    return <option key={m.id} value={m.id}>{label}</option>;
                  })}
                </select>
                <p className="fr-hint-text">Les champs (intitulé, clause, dates…) sont repris automatiquement.</p>
              </div>
            ) : (
              <div className="fr-alert fr-alert--info fr-mb-3w"><p>Vous n’avez pas encore de marché associé à votre entité.</p></div>
            )}

            <h2 className="fr-h6">Destinataires</h2>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="to">À (e-mail)</label>
              <input id="to" className="fr-input" type="email" value={to} onChange={(e)=>setTo(e.target.value)} />
              {to && !emailLooksOk(to) && <p className="fr-error-text">Format d’e-mail invalide.</p>}
            </div>
            <div className="fr-input-group">
              <label className="fr-label" htmlFor="cc">Copie (CC)</label>
              <input id="cc" className="fr-input" type="email" value={cc} onChange={(e)=>setCc(e.target.value)} />
              {cc && !emailLooksOk(cc) && <p className="fr-error-text">Format d’e-mail invalide.</p>}
            </div>
          </div>
        </div>

        {/* Colonne droite : aperçu & actions */}
        <div className="fr-col-12 fr-col-lg-7">
          <div className="fr-card fr-p-3w">
            <h2 className="fr-h6">Aperçu</h2>

            <div className="fr-input-group">
              <label className="fr-label" htmlFor="sujet">Sujet</label>
              <input id="sujet" className="fr-input" type="text" value={subject} onChange={(e)=>setSubject(e.target.value)} />
            </div>

            <div className="fr-input-group">
              <label className="fr-label" htmlFor="corps">Message</label>
              <textarea id="corps" className="fr-input" rows="12" value={body} onChange={(e)=>setBody(e.target.value)} />
              <p className="fr-hint-text">Texte brut (compatible tous clients e-mail).</p>
            </div>

            <div className="fr-btns-group fr-btns-group--inline fr-btns-group--right fr-mt-2w">
              <button className="fr-btn fr-btn--secondary" onClick={()=>copyText(subject)}>Copier le sujet</button>
              <button className="fr-btn fr-btn--secondary" onClick={()=>copyText(body)}>Copier le message</button>
              <a className="fr-btn" href={buildMailto()} onClick={(e)=>{ const href = buildMailto(); if (href==='#') e.preventDefault(); }}>
                Ouvrir mon client mail
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
};
